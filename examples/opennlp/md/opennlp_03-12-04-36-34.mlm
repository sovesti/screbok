                <children xsi:type="mlm:WrappingNode">
                  <children xsi:type="mlm:Reference" link="#tools.cli.namefind.TokenNameFinder" referenced="//@children.0/@children.1/@children.20/@children.8/@children.3/@children.0/@title/@children.0">
                    <title xsi:type="mlm:RawText" text="TokenNameFinder"/>
                  </children>
                  <children xsi:type="mlm:WrappingNode" transient="true"/>
                </children>
                <children xsi:type="mlm:WrappingNode">
                  <children xsi:type="mlm:Reference" link="#tools.cli.namefind.TokenNameFinderTrainer" referenced="//@children.0/@children.1/@children.20/@children.8/@children.4/@children.0/@title/@children.0">
                    <title xsi:type="mlm:RawText" text="TokenNameFinderTrainer"/>
                  </children>
                  <children xsi:type="mlm:WrappingNode" transient="true"/>
                </children>

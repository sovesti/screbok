              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="Converts foreign data formats (ontonotes,frenchtreebank) to native OpenNLP format"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:RawText" text="Usage: opennlp ParserConverter help|ontonotes|frenchtreebank [help|options...]&#xA;&#xA;&#xA;"/>

                </parts>
              </children>
              <children xsi:type="mlm:RawText" text=", "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:Emphasized">
                  <parts xsi:type="mlm:RawText" text="&quot;NOUN&quot;"/>
                </parts>
              </children>
              <children xsi:type="mlm:RawText" text=", "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:Emphasized">
                  <parts xsi:type="mlm:RawText" text="&quot;ADP&quot;"/>
                </parts>
              </children>
              <children xsi:type="mlm:RawText" text=", "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:Emphasized">
                  <parts xsi:type="mlm:RawText" text="&quot;PROPN&quot;"/>
                </parts>
              </children>
              <children xsi:type="mlm:RawText" text=", "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:Emphasized">
                  <parts xsi:type="mlm:RawText" text="&quot;PUNCT&quot;"/>
                </parts>
              </children>
              <children xsi:type="mlm:RawText" text=", "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:Emphasized">
                  <parts xsi:type="mlm:RawText" text="&quot;NUM&quot;"/>
                </parts>
              </children>
              <children xsi:type="mlm:RawText" text=", "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:Emphasized">
                  <parts xsi:type="mlm:RawText" text="&quot;NOUN&quot;"/>
                </parts>
              </children>
              <children xsi:type="mlm:RawText" text=",&#xA;    "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:Emphasized">
                  <parts xsi:type="mlm:RawText" text="&quot;PUNCT&quot;"/>
                </parts>
              </children>
              <children xsi:type="mlm:RawText" text=" };&#xA;&#xA;String[] lemmas = lemmatizer.lemmatize(tokens, postags);&#xA;               "/>
            </content>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="The lemmas array contains one lemma for each token in the input array. The corresponding tag and lemma can be found at the same index as the token has in the input array."/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="The DictionaryLemmatizer is constructed by passing the InputStream of a lemmatizer dictionary. Such dictionary consists of a text file containing, for each row, a word, its postag and the corresponding lemma, each column separated by a tab character."/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:CodeListing">
            <content xsi:type="mlm:RawText" text="                &#xA;show            NOUN    show&#xA;showcase        NOUN    showcase&#xA;showcases       NOUN    showcase&#xA;showdown        NOUN    showdown&#xA;showdowns       NOUN    showdown&#xA;shower          NOUN    shower&#xA;showers         NOUN    shower&#xA;showman         NOUN    showman&#xA;showmanship     NOUN    showmanship&#xA;showmen         NOUN    showman&#xA;showroom        NOUN    showroom&#xA;showrooms       NOUN    showroom&#xA;shows           NOUN    show&#xA;shrapnel        NOUN    shrapnel&#xA;                &#xA;               "/>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="Alternatively, if a (word,postag) pair can output multiple lemmas, the the lemmatizer dictionary would consist of a text file containing, for each row, a word, its postag and the corresponding lemmas separated by &quot;#&quot;:"/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:CodeListing">
            <content xsi:type="mlm:RawText" text="                &#xA;muestras        NOUN    muestra&#xA;cantaba         VERB    cantar&#xA;fue             VERB    ir#ser&#xA;entramos        VERB    entrar&#xA;                &#xA;                                       "/>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="First the dictionary must be loaded into memory from disk or another source. In the sample below it is loaded from disk."/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:CodeListing">
            <content xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:RawText" text="                                &#xA;InputStream dictLemmatizer = null;&#xA;&#xA;"/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="try"/>
              </children>
              <children xsi:type="mlm:RawText" text=" (dictLemmatizer = "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="new"/>
              </children>
              <children xsi:type="mlm:RawText" text=" FileInputStream("/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:Emphasized">
                  <parts xsi:type="mlm:RawText" text="&quot;english-dict-lemmatizer.txt&quot;"/>
                </parts>
              </children>
              <children xsi:type="mlm:RawText" text=")) {&#xA;&#xA;}&#xA;&#xA;                       "/>
            </content>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="After the dictionary is loaded the DictionaryLemmatizer can be instantiated."/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:CodeListing">
            <content xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:RawText" text="                          &#xA;DictionaryLemmatizer lemmatizer = "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="new"/>
              </children>
              <children xsi:type="mlm:RawText" text=" DictionaryLemmatizer(dictLemmatizer);&#xA;                       "/>
            </content>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="The DictionaryLemmatizer instance is now ready. It expects two String arrays as input, a containing the tokens and another one their respective postags."/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="The following code shows how to find a lemma using a DictionaryLemmatizer."/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:CodeListing">
            <content xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:RawText" text="                  &#xA;String[] tokens = "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="new"/>
              </children>
              <children xsi:type="mlm:RawText" text=" String[]{"/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:Emphasized">
                  <parts xsi:type="mlm:RawText" text="&quot;Most&quot;"/>
                </parts>
              </children>
              <children xsi:type="mlm:RawText" text=", "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:Emphasized">
                  <parts xsi:type="mlm:RawText" text="&quot;large&quot;"/>
                </parts>
              </children>
              <children xsi:type="mlm:RawText" text=", "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:Emphasized">
                  <parts xsi:type="mlm:RawText" text="&quot;cities&quot;"/>
                </parts>
              </children>
              <children xsi:type="mlm:RawText" text=", "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:Emphasized">
                  <parts xsi:type="mlm:RawText" text="&quot;in&quot;"/>
                </parts>
              </children>
              <children xsi:type="mlm:RawText" text=", "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:Emphasized">
                  <parts xsi:type="mlm:RawText" text="&quot;the&quot;"/>
                </parts>
              </children>
              <children xsi:type="mlm:RawText" text=", "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:Emphasized">
                  <parts xsi:type="mlm:RawText" text="&quot;US&quot;"/>
                </parts>
              </children>
              <children xsi:type="mlm:RawText" text=", "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:Emphasized">
                  <parts xsi:type="mlm:RawText" text="&quot;had&quot;"/>
                </parts>
              </children>
              <children xsi:type="mlm:RawText" text=",&#xA;                             "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:Emphasized">
                  <parts xsi:type="mlm:RawText" text="&quot;morning&quot;"/>
                </parts>
              </children>
              <children xsi:type="mlm:RawText" text=", "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:Emphasized">
                  <parts xsi:type="mlm:RawText" text="&quot;and&quot;"/>
                </parts>
              </children>
              <children xsi:type="mlm:RawText" text=", "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:Emphasized">
                  <parts xsi:type="mlm:RawText" text="&quot;afternoon&quot;"/>
                </parts>
              </children>
              <children xsi:type="mlm:RawText" text=", "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:Emphasized">
                  <parts xsi:type="mlm:RawText" text="&quot;newspapers&quot;"/>
                </parts>
              </children>
              <children xsi:type="mlm:RawText" text=", "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:Emphasized">
                  <parts xsi:type="mlm:RawText" text="&quot;.&quot;"/>
                </parts>
              </children>
              <children xsi:type="mlm:RawText" text="};&#xA;String[] tags = tagger.tag(sent);&#xA;String[] lemmas = lemmatizer.lemmatize(tokens, postags);&#xA;&#xA;                       "/>
            </content>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="The tags array contains one part-of-speech tag for each token in the input array. The corresponding tag and lemmas can be found at the same index as the token has in the input array."/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
        </children>
        <children xsi:type="mlm:WrappingNode" transient="true">
          <children xsi:type="mlm:Section" level="3">
            <title xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:Anchor" name="tools.lemmatizer.training"/>
              <children xsi:type="mlm:RawText" text="Lemmatizer Training"/>
            </title>
          </children>
          <children xsi:type="mlm:LineBreak"/>
          <children xsi:type="mlm:MarkupList">
            <items xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:WrappingNode">
                <children xsi:type="mlm:Reference" link="#tools.lemmatizer.training.tool" referenced="//@children.0/@children.1/@children.10/@children.5/@children.7/@children.0/@title/@children.0">
                  <title xsi:type="mlm:RawText" text="Training Tool"/>
                </children>
                <children xsi:type="mlm:WrappingNode" transient="true"/>
              </children>
              <children xsi:type="mlm:WrappingNode">
                <children xsi:type="mlm:Reference" link="#tools.lemmatizer.training.api" referenced="//@children.0/@children.1/@children.10/@children.5/@children.8/@children.0/@title/@children.0">
                  <title xsi:type="mlm:RawText" text="Training API"/>
                </children>
                <children xsi:type="mlm:WrappingNode" transient="true"/>
              </children>
            </items>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="The training data consist of three columns separated by tabs. Each word has been put on a separate line and there is an empty line after each sentence. The first column contains the current word, the second its part-of-speech tag and the third its lemma. Here is an example of the file format:"/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="Sample sentence of the training data:"/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:CodeListing">
            <content xsi:type="mlm:RawText" text="                &#xA;He        PRON  he&#xA;reckons   VERB  reckon&#xA;the       DET   the&#xA;current   ADJ   current&#xA;accounts  NOUN  account&#xA;deficit   NOUN   deficit&#xA;will      AUX   will&#xA;narrow    VERB   narrow&#xA;to        PART   to&#xA;only      ADV   only&#xA;#         #    #&#xA;1.8       NUM   1.8&#xA;millions  NOUN   million&#xA;in        ADP   in&#xA;September PROPN  september&#xA;.         PUNCT   O&#xA;               "/>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="The Universal Dependencies Treebank and the CoNLL 2009 datasets distribute training data for many languages."/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:Section" level="4">
              <title xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:Anchor" name="tools.lemmatizer.training.tool"/>
                <children xsi:type="mlm:RawText" text="Training Tool"/>
              </title>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="OpenNLP has a command line tool which is used to train the models on various corpora."/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="Usage of the tool:"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:RawText" text="                &#xA;$ opennlp LemmatizerTrainerME&#xA;Usage: opennlp LemmatizerTrainerME [-factory factoryName] [-params paramsFile] -lang language -model modelFile -data sampleData [-encoding charsetName]&#xA;&#xA;Arguments description:&#xA;        -factory factoryName&#xA;                A sub-class of LemmatizerFactory where to get implementation and resources.&#xA;        -params paramsFile&#xA;                training parameters file.&#xA;        -lang language&#xA;                language which is being processed.&#xA;        -model modelFile&#xA;                output model file.&#xA;        -data sampleData&#xA;                data to be used, usually a file name.&#xA;        -encoding charsetName&#xA;        encoding for reading and writing text, if absent the system default is used.&#xA;                &#xA;               "/>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="Its now assumed that the english lemmatizer model should be trained from a file called 'en-custom-lemmatizer.train' which is encoded as UTF-8. The following command will train the lemmatizer and write the model to en-custom-lemmatizer.bin:"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:RawText" text="                &#xA;$ opennlp LemmatizerTrainerME -model en-custom-lemmatizer.bin -params PerceptronTrainerParams.txt -lang en -data en-custom-lemmatizer.train -encoding UTF-8&#xA;               "/>
            </children>
          </children>
          <children xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:Section" level="4">
              <title xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:Anchor" name="tools.lemmatizer.training.api"/>
                <children xsi:type="mlm:RawText" text="Training API"/>
              </title>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="The Lemmatizer offers an API to train a new lemmatizer model. First a training parameters file needs to be instantiated:"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:RawText" text="                    &#xA; TrainingParameters mlParams = CmdLineUtil.loadTrainingParameters(params.getParams(), false);&#xA; "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="if"/>
                </children>
                <children xsi:type="mlm:RawText" text=" (mlParams == null) {&#xA;   mlParams = ModelUtil.createDefaultTrainingParameters();&#xA; }&#xA;               "/>
              </content>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="Then we read the training data:"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:RawText" text="                    &#xA;InputStreamFactory inputStreamFactory = null;&#xA;    "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="try"/>
                </children>
                <children xsi:type="mlm:RawText" text=" {&#xA;      inputStreamFactory = "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" MarkableFileInputStreamFactory(&#xA;          "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" File(en-custom-lemmatizer.train));&#xA;    } "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="catch"/>
                </children>
                <children xsi:type="mlm:RawText" text=" (FileNotFoundException e) {&#xA;      e.printStackTrace();&#xA;    }&#xA;    ObjectStream&lt;String> lineStream = null;&#xA;    LemmaSampleStream lemmaStream = null;&#xA;    "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="try"/>
                </children>
                <children xsi:type="mlm:RawText" text=" {&#xA;      lineStream = "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" PlainTextByLineStream(&#xA;      (inputStreamFactory), StandardCharsets.UTF_"/>
                <children xsi:type="mlm:RawText" text="8"/>
                <children xsi:type="mlm:RawText" text=");&#xA;      lemmaStream = "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" LemmaSampleStream(lineStream);&#xA;    } "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="catch"/>
                </children>
                <children xsi:type="mlm:RawText" text=" (IOException e) {&#xA;      CmdLineUtil.handleCreateObjectStreamError(e);&#xA;    }&#xA;&#xA;               "/>
              </content>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="The following step proceeds to train the model:"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:RawText" text="    LemmatizerModel model;&#xA;    try {&#xA;      LemmatizerFactory lemmatizerFactory = LemmatizerFactory&#xA;          .create(params.getFactory());&#xA;      model = LemmatizerME.train(params.getLang(), lemmaStream, mlParams,&#xA;          lemmatizerFactory);&#xA;    } catch (IOException e) {&#xA;      throw new TerminateToolException(-1,&#xA;          &quot;IO error while reading training data or indexing data: &quot;&#xA;              + e.getMessage(),&#xA;          e);&#xA;    } finally {&#xA;      try {&#xA;        sampleStream.close();&#xA;      } catch (IOException e) {&#xA;      }&#xA;    }&#xA;               "/>
            </children>
          </children>
        </children>
        <children xsi:type="mlm:WrappingNode" transient="true">
          <children xsi:type="mlm:Section" level="3">
            <title xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:Anchor" name="tools.lemmatizer.evaluation"/>
              <children xsi:type="mlm:RawText" text="Lemmatizer Evaluation"/>
            </title>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="The built in evaluation can measure the accuracy of the statistical lemmatizer. The accuracy can be measured on a test data set."/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="There is a command line tool to evaluate a given model on a test data set. The following command shows how the tool can be run:"/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:CodeListing">
            <content xsi:type="mlm:RawText" text="                                &#xA;$ opennlp LemmatizerEvaluator -model en-custom-lemmatizer.bin -data en-custom-lemmatizer.test -encoding utf-8&#xA;                        "/>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="This will display the resulting accuracy score, e.g.:"/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:CodeListing">
            <content xsi:type="mlm:RawText" text="                                &#xA;Loading model ... done&#xA;Evaluating ... done&#xA;&#xA;Accuracy: 0.9659110277825124&#xA;                        "/>
          </children>
        </children>
      </children>
      <children xsi:type="mlm:WrappingNode" transient="true">
        <children xsi:type="mlm:Section" level="2">
          <title xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:Anchor" name="tools.chunker"/>
            <children xsi:type="mlm:RawText" text="Chapter&#xa0;9.&#xa0;Chunker"/>
          </title>
        </children>
        <children xsi:type="mlm:Section" level="5">
          <title xsi:type="mlm:Emphasized" type="BOLD">
            <parts xsi:type="mlm:RawText" text="Table of Contents"/>
          </title>
          <children xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:Reference" link="#tools.parser.chunking" referenced="//@children.0/@children.1/@children.11/@children.2/@children.0/@title/@children.0">
                <title xsi:type="mlm:RawText" text="Chunking"/>
              </children>
              <children xsi:type="mlm:WrappingNode" transient="true"/>
            </children>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:MarkupList">
              <items xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:WrappingNode">
                  <children xsi:type="mlm:Reference" link="#tools.parser.chunking.cmdline" referenced="//@children.0/@children.1/@children.11/@children.2/@children.4/@children.0/@title/@children.0">
                    <title xsi:type="mlm:RawText" text="Chunker Tool"/>
                  </children>
                  <children xsi:type="mlm:WrappingNode" transient="true"/>
                </children>
                <children xsi:type="mlm:WrappingNode">
                  <children xsi:type="mlm:Reference" link="#tools.parser.chunking.api" referenced="//@children.0/@children.1/@children.11/@children.2/@children.5/@children.0/@title/@children.0">
                    <title xsi:type="mlm:RawText" text="Chunking API"/>
                  </children>
                  <children xsi:type="mlm:WrappingNode" transient="true"/>
                </children>
              </items>
            </children>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:Reference" link="#tools.chunker.training" referenced="//@children.0/@children.1/@children.11/@children.3/@children.0/@title/@children.0">
                <title xsi:type="mlm:RawText" text="Chunker Training"/>
              </children>
              <children xsi:type="mlm:WrappingNode" transient="true"/>
            </children>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:MarkupList">
              <items xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:WrappingNode">
                  <children xsi:type="mlm:Reference" link="#tools.chunker.training.tool" referenced="//@children.0/@children.1/@children.11/@children.3/@children.9/@children.0/@title/@children.0">
                    <title xsi:type="mlm:RawText" text="Training Tool"/>
                  </children>
                  <children xsi:type="mlm:WrappingNode" transient="true"/>
                </children>
                <children xsi:type="mlm:WrappingNode">
                  <children xsi:type="mlm:Reference" link="#tools.chunker.training.api" referenced="//@children.0/@children.1/@children.11/@children.3/@children.10/@children.0/@title/@children.0">
                    <title xsi:type="mlm:RawText" text="Training API"/>
                  </children>
                  <children xsi:type="mlm:WrappingNode" transient="true"/>
                </children>
              </items>
            </children>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:Reference" link="#tools.chunker.evaluation" referenced="//@children.0/@children.1/@children.11/@children.4/@children.0/@title/@children.0">
                <title xsi:type="mlm:RawText" text="Chunker Evaluation"/>
              </children>
              <children xsi:type="mlm:WrappingNode" transient="true"/>
            </children>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:MarkupList">
              <items xsi:type="mlm:WrappingNode">
                <children xsi:type="mlm:Reference" link="#tools.chunker.evaluation.tool" referenced="//@children.0/@children.1/@children.11/@children.4/@children.4/@children.0/@title/@children.0">
                  <title xsi:type="mlm:RawText" text="Chunker Evaluation Tool"/>
                </children>
                <children xsi:type="mlm:WrappingNode" transient="true"/>
              </items>
            </children>
            <children xsi:type="mlm:LineBreak"/>
          </children>
        </children>
        <children xsi:type="mlm:WrappingNode" transient="true">
          <children xsi:type="mlm:Section" level="3">
            <title xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:Anchor" name="tools.parser.chunking"/>
              <children xsi:type="mlm:RawText" text="Chunking"/>
            </title>
          </children>
          <children xsi:type="mlm:LineBreak"/>
          <children xsi:type="mlm:MarkupList">
            <items xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:WrappingNode">
                <children xsi:type="mlm:Reference" link="#tools.parser.chunking.cmdline" referenced="//@children.0/@children.1/@children.11/@children.2/@children.4/@children.0/@title/@children.0">
                  <title xsi:type="mlm:RawText" text="Chunker Tool"/>
                </children>
                <children xsi:type="mlm:WrappingNode" transient="true"/>
              </children>
              <children xsi:type="mlm:WrappingNode">
                <children xsi:type="mlm:Reference" link="#tools.parser.chunking.api" referenced="//@children.0/@children.1/@children.11/@children.2/@children.5/@children.0/@title/@children.0">
                  <title xsi:type="mlm:RawText" text="Chunking API"/>
                </children>
                <children xsi:type="mlm:WrappingNode" transient="true"/>
              </children>
            </items>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="Text chunking consists of dividing a text in syntactically correlated parts of words, like noun groups, verb groups, but does not specify their internal structure, nor their role in the main sentence."/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:Section" level="4">
              <title xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:Anchor" name="tools.parser.chunking.cmdline"/>
                <children xsi:type="mlm:RawText" text="Chunker Tool"/>
              </title>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="The easiest way to try out the Chunker is the command line tool. The tool is only intended for demonstration and testing."/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="Download the English maxent chunker model from the website and start the Chunker Tool with this command:"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:RawText" text="                                &#xA;$ opennlp ChunkerME en-chunker.bin&#xA;               "/>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="The Chunker now reads a pos tagged sentence per line from stdin. Copy these two sentences to the console:"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:RawText" text="                                &#xA;Rockwell_NNP International_NNP Corp._NNP 's_POS Tulsa_NNP unit_NN said_VBD it_PRP signed_VBD &#xA;    a_DT tentative_JJ agreement_NN extending_VBG its_PRP$ contract_NN with_IN Boeing_NNP Co._NNP&#xA;    to_TO provide_VB structural_JJ parts_NNS for_IN Boeing_NNP 's_POS 747_CD jetliners_NNS ._.&#xA;Rockwell_NNP said_VBD the_DT agreement_NN calls_VBZ for_IN it_PRP to_TO supply_VB 200_CD&#xA;    additional_JJ so-called_JJ shipsets_NNS for_IN the_DT planes_NNS ._.&#xA;               "/>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="The Chunker will now echo the sentences grouped tokens to the console:"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:RawText" text="                                &#xA;[NP Rockwell_NNP International_NNP Corp._NNP ] [NP 's_POS Tulsa_NNP unit_NN ] [VP said_VBD ]&#xA;    [NP it_PRP ] [VP signed_VBD ] [NP a_DT tentative_JJ agreement_NN ] [VP extending_VBG ]&#xA;    [NP its_PRP$ contract_NN ] [PP with_IN ] [NP Boeing_NNP Co._NNP ] [VP to_TO provide_VB ]&#xA;    [NP structural_JJ parts_NNS ] [PP for_IN ] [NP Boeing_NNP ] [NP 's_POS 747_CD jetliners_NNS ] ._.&#xA;[NP Rockwell_NNP ] [VP said_VBD ] [NP the_DT agreement_NN ] [VP calls_VBZ ] [SBAR for_IN ]&#xA;    [NP it_PRP ] [VP to_TO supply_VB ] [NP 200_CD additional_JJ so-called_JJ shipsets_NNS ]&#xA;    [PP for_IN ] [NP the_DT planes_NNS ] ._.&#xA;               "/>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:RawText" text="The tag set used by the English pos model is the "/>
                <children xsi:type="mlm:Reference" link="https://www.ling.upenn.edu/courses/Fall_2003/ling001/penn_treebank_pos.html">
                  <title xsi:type="mlm:RawText" text="Penn Treebank tag set"/>
                </children>
                <children xsi:type="mlm:RawText" text="."/>
              </children>
              <children xsi:type="mlm:LineBreak"/>
            </children>
          </children>
          <children xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:Section" level="4">
              <title xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:Anchor" name="tools.parser.chunking.api"/>
                <children xsi:type="mlm:RawText" text="Chunking API"/>
              </title>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="The Chunker can be embedded into an application via its API. First the chunker model must be loaded into memory from disk or another source. In the sample below it is loaded from disk."/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:RawText" text="                                &#xA;InputStream modelIn = null;&#xA;ChunkerModel model = null;&#xA;&#xA;"/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="try"/>
                </children>
                <children xsi:type="mlm:RawText" text=" (modelIn = "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" FileInputStream("/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;en-chunker.bin&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=")){&#xA;  model = "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" ChunkerModel(modelIn);&#xA;}&#xA;                       "/>
              </content>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="After the model is loaded a Chunker can be instantiated."/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:RawText" text="                                &#xA;ChunkerME chunker = "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" ChunkerME(model);&#xA;                       "/>
              </content>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="The Chunker instance is now ready to tag data. It expects a tokenized sentence as input, which is represented as a String array, each String object in the array is one token, and the POS tags associated with each token."/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="The following code shows how to determine the most likely chunk tag sequence for a sentence."/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:RawText" text="                  &#xA;String[] sent = "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" String[] { "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;Rockwell&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;International&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;Corp.&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;'s&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=",&#xA;    "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;Tulsa&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;unit&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;said&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;it&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;signed&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;a&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;tentative&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;agreement&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=",&#xA;    "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;extending&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;its&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;contract&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;with&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;Boeing&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;Co.&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;to&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=",&#xA;    "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;provide&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;structural&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;parts&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;for&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;Boeing&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;'s&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;747&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=",&#xA;    "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;jetliners&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;.&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=" };&#xA;&#xA;String[] pos = "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" String[] { "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;NNP&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;NNP&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;NNP&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;POS&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;NNP&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;NN&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=",&#xA;    "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;VBD&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;PRP&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;VBD&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;DT&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;JJ&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;NN&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;VBG&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;PRP$&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;NN&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;IN&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=",&#xA;    "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;NNP&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;NNP&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;TO&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;VB&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;JJ&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;NNS&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;IN&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;NNP&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;POS&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;CD&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;NNS&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=",&#xA;    "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;.&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=" };&#xA;&#xA;String[] tag = chunker.chunk(sent, pos);&#xA;                       "/>
              </content>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="The tags array contains one chunk tag for each token in the input array. The corresponding tag can be found at the same index as the token has in the input array. The confidence scores for the returned tags can be easily retrieved from a ChunkerME with the following method call:"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:RawText" text="                  &#xA;"/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="double"/>
                </children>
                <children xsi:type="mlm:RawText" text="[] probs = chunker.probs();&#xA;                       "/>
              </content>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="The call to probs is stateful and will always return the probabilities of the last tagged sentence. The probs method should only be called when the tag method was called before, otherwise the behavior is undefined."/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="Some applications need to retrieve the n-best chunk tag sequences and not only the best sequence. The topKSequences method is capable of returning the top sequences. It can be called in a similar way as chunk."/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:RawText" text="                  &#xA;Sequence[] topSequences = chunk.topKSequences(sent, pos);&#xA;                       "/>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="Each Sequence object contains one sequence. The sequence can be retrieved via Sequence.getOutcomes() which returns a tags array and Sequence.getProbs() returns the probability array for this sequence."/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
          </children>
        </children>
        <children xsi:type="mlm:WrappingNode" transient="true">
          <children xsi:type="mlm:Section" level="3">
            <title xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:Anchor" name="tools.chunker.training"/>
              <children xsi:type="mlm:RawText" text="Chunker Training"/>
            </title>
          </children>
          <children xsi:type="mlm:LineBreak"/>
          <children xsi:type="mlm:MarkupList">
            <items xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:WrappingNode">
                <children xsi:type="mlm:Reference" link="#tools.chunker.training.tool" referenced="//@children.0/@children.1/@children.11/@children.3/@children.9/@children.0/@title/@children.0">
                  <title xsi:type="mlm:RawText" text="Training Tool"/>
                </children>
                <children xsi:type="mlm:WrappingNode" transient="true"/>
              </children>
              <children xsi:type="mlm:WrappingNode">
                <children xsi:type="mlm:Reference" link="#tools.chunker.training.api" referenced="//@children.0/@children.1/@children.11/@children.3/@children.10/@children.0/@title/@children.0">
                  <title xsi:type="mlm:RawText" text="Training API"/>
                </children>
                <children xsi:type="mlm:WrappingNode" transient="true"/>
              </children>
            </items>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="The pre-trained models might not be available for a desired language, can not detect important entities or the performance is not good enough outside the news domain."/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="These are the typical reason to do custom training of the chunker on a new corpus or on a corpus which is extended by private training data taken from the data which should be analyzed."/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:RawText" text="The training data can be converted to the OpenNLP chunker training format, which is based on "/>
              <children xsi:type="mlm:Reference" link="https://www.cnts.ua.ac.be/conll2000/chunking">
                <title xsi:type="mlm:RawText" text="CoNLL2000"/>
              </children>
              <children xsi:type="mlm:RawText" text=". Other formats may also be available. The training data consist of three columns separated one single space. Each word has been put on a separate line and there is an empty line after each sentence. The first column contains the current word, the second its part-of-speech tag and the third its chunk tag. The chunk tags contain the name of the chunk type, for example I-NP for noun phrase words and I-VP for verb phrase words. Most chunk types have two types of chunk tags, B-CHUNK for the first word of the chunk and I-CHUNK for each other word in the chunk. Here is an example of the file format:"/>
            </children>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="Sample sentence of the training data:"/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:CodeListing">
            <content xsi:type="mlm:RawText" text="                                &#xA;He        PRP  B-NP&#xA;reckons   VBZ  B-VP&#xA;the       DT   B-NP&#xA;current   JJ   I-NP&#xA;account   NN   I-NP&#xA;deficit   NN   I-NP&#xA;will      MD   B-VP&#xA;narrow    VB   I-VP&#xA;to        TO   B-PP&#xA;only      RB   B-NP&#xA;#         #    I-NP&#xA;1.8       CD   I-NP&#xA;billion   CD   I-NP&#xA;in        IN   B-PP&#xA;September NNP  B-NP&#xA;.         .    O&#xA;               "/>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="Note that for improved visualization the example above uses tabs instead of a single space as column separator."/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:Section" level="4">
              <title xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:Anchor" name="tools.chunker.training.tool"/>
                <children xsi:type="mlm:RawText" text="Training Tool"/>
              </title>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="OpenNLP has a command line tool which is used to train the models available from the model download page on various corpora."/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="Usage of the tool:"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:RawText" text="                                &#xA;$ opennlp ChunkerTrainerME&#xA;Usage: opennlp ChunkerTrainerME[.ad] [-params paramsFile] [-iterations num] [-cutoff num] \&#xA;               -model modelFile -lang language -data sampleData [-encoding charsetName]&#xA;&#xA;Arguments description:&#xA;        -params paramsFile&#xA;                training parameters file.&#xA;        -iterations num&#xA;                number of training iterations, ignored if -params is used.&#xA;        -cutoff num&#xA;                minimal number of times a feature must be seen, ignored if -params is used.&#xA;        -model modelFile&#xA;                output model file.&#xA;        -lang language&#xA;                language which is being processed.&#xA;        -data sampleData&#xA;                data to be used, usually a file name.&#xA;        -encoding charsetName&#xA;                encoding for reading and writing text, if absent the system default is used.&#xA;               "/>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="Its now assumed that the English chunker model should be trained from a file called en-chunker.train which is encoded as UTF-8. The following command will train the name finder and write the model to en-chunker.bin:"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:RawText" text="                &#xA;$ opennlp ChunkerTrainerME -model en-chunker.bin -lang en -data en-chunker.train -encoding UTF-8&#xA;               "/>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="Additionally its possible to specify the number of iterations, the cutoff and to overwrite all types in the training data with a single type."/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
          </children>
          <children xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:Section" level="4">
              <title xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:Anchor" name="tools.chunker.training.api"/>
                <children xsi:type="mlm:RawText" text="Training API"/>
              </title>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="The Chunker offers an API to train a new chunker model. The following sample code illustrates how to do it:"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:RawText" text="                    &#xA;ObjectStream&lt;String> lineStream =&#xA;    "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" PlainTextByLineStream("/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" MarkableFileInputStreamFactory("/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" File("/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;en-chunker.train&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=")), StandardCharsets.UTF_"/>
                <children xsi:type="mlm:RawText" text="8"/>
                <children xsi:type="mlm:RawText" text=");&#xA;&#xA;ChunkerModel model;&#xA;&#xA;"/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="try"/>
                </children>
                <children xsi:type="mlm:RawText" text="(ObjectStream&lt;ChunkSample> sampleStream = "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" ChunkSampleStream(lineStream)) {&#xA;  model = ChunkerME.train("/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;eng&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", sampleStream,&#xA;       TrainingParameters.defaultParams(), "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" ChunkerFactory());&#xA;}&#xA;&#xA;"/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="try"/>
                </children>
                <children xsi:type="mlm:RawText" text=" (OutputStream modelOut = "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" BufferedOutputStream("/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" FileOutputStream(modelFile))) {&#xA;  model.serialize(modelOut);&#xA;}&#xA;               "/>
              </content>
            </children>
          </children>
        </children>
        <children xsi:type="mlm:WrappingNode" transient="true">
          <children xsi:type="mlm:Section" level="3">
            <title xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:Anchor" name="tools.chunker.evaluation"/>
              <children xsi:type="mlm:RawText" text="Chunker Evaluation"/>
            </title>
          </children>
          <children xsi:type="mlm:LineBreak"/>
          <children xsi:type="mlm:MarkupList">
            <items xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:Reference" link="#tools.chunker.evaluation.tool" referenced="//@children.0/@children.1/@children.11/@children.4/@children.4/@children.0/@title/@children.0">
                <title xsi:type="mlm:RawText" text="Chunker Evaluation Tool"/>
              </children>
              <children xsi:type="mlm:WrappingNode" transient="true"/>
            </items>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="The built-in evaluation can measure the chunker performance. The performance is either measured on a test dataset or via cross validation."/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:Section" level="4">
              <title xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:Anchor" name="tools.chunker.evaluation.tool"/>
                <children xsi:type="mlm:RawText" text="Chunker Evaluation Tool"/>
              </title>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="The following command shows how the tool can be run:"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:RawText" text="                                &#xA;$ opennlp ChunkerEvaluator&#xA;Usage: opennlp ChunkerEvaluator[.ad] -model model [-misclassified true|false] \&#xA;               [-detailedF true|false] -lang language -data sampleData [-encoding charsetName]&#xA;               "/>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="A sample of the command considering you have a data sample named en-chunker.eval and you trained a model called en-chunker.bin:"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:RawText" text="                                &#xA;$ opennlp ChunkerEvaluator -model en-chunker.bin -data en-chunker.eval -encoding UTF-8&#xA;               "/>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="and here is a sample output:"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:RawText" text="                &#xA;Precision: 0.9255923572240226&#xA;Recall: 0.9220610430991112&#xA;F-Measure: 0.9238233255623465&#xA;               "/>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="You can also use the tool to perform 10-fold cross validation of the Chunker. The following command shows how the tool can be run:"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:RawText" text="                                &#xA;$ opennlp ChunkerCrossValidator&#xA;Usage: opennlp ChunkerCrossValidator[.ad] [-params paramsFile] [-iterations num] [-cutoff num] \&#xA;               [-misclassified true|false] [-folds num] [-detailedF true|false] \&#xA;               -lang language -data sampleData [-encoding charsetName]&#xA;&#xA;Arguments description:&#xA;        -params paramsFile&#xA;                training parameters file.&#xA;        -iterations num&#xA;                number of training iterations, ignored if -params is used.&#xA;        -cutoff num&#xA;                minimal number of times a feature must be seen, ignored if -params is used.&#xA;        -misclassified true|false&#xA;                if true will print false negatives and false positives.&#xA;        -folds num&#xA;                number of folds, default is 10.&#xA;        -detailedF true|false&#xA;                if true will print detailed FMeasure results.&#xA;        -lang language&#xA;                language which is being processed.&#xA;        -data sampleData&#xA;                data to be used, usually a file name.&#xA;        -encoding charsetName&#xA;                encoding for reading and writing text, if absent the system default is used.&#xA;               "/>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="It is not necessary to pass a model. The tool will automatically split the data to train and evaluate:"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:RawText" text="            &#xA;$ opennlp ChunkerCrossValidator -lang pt -data en-chunker.cross -encoding UTF-8&#xA;               "/>
            </children>
          </children>
        </children>
      </children>
      <children xsi:type="mlm:WrappingNode" transient="true">
        <children xsi:type="mlm:Section" level="2">
          <title xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:Anchor" name="tools.parser"/>
            <children xsi:type="mlm:RawText" text="Chapter&#xa0;10.&#xa0;Parser"/>
          </title>
        </children>
        <children xsi:type="mlm:Section" level="5">
          <title xsi:type="mlm:Emphasized" type="BOLD">
            <parts xsi:type="mlm:RawText" text="Table of Contents"/>
          </title>
          <children xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:Reference" link="#tools.parser.parsing" referenced="//@children.0/@children.1/@children.12/@children.2/@children.0/@title/@children.0">
                <title xsi:type="mlm:RawText" text="Parsing"/>
              </children>
              <children xsi:type="mlm:WrappingNode" transient="true"/>
            </children>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:MarkupList">
              <items xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:WrappingNode">
                  <children xsi:type="mlm:Reference" link="#tools.parser.parsing.cmdline" referenced="//@children.0/@children.1/@children.12/@children.2/@children.7/@children.0/@title/@children.0">
                    <title xsi:type="mlm:RawText" text="Parser Tool"/>
                  </children>
                  <children xsi:type="mlm:WrappingNode" transient="true"/>
                </children>
                <children xsi:type="mlm:WrappingNode">
                  <children xsi:type="mlm:Reference" link="#tools.parser.parsing.api" referenced="//@children.0/@children.1/@children.12/@children.2/@children.8/@children.0/@title/@children.0">
                    <title xsi:type="mlm:RawText" text="Parsing API"/>
                  </children>
                  <children xsi:type="mlm:WrappingNode" transient="true"/>
                </children>
              </items>
            </children>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:Reference" link="#tools.parser.training" referenced="//@children.0/@children.1/@children.12/@children.3/@children.0/@title/@children.0">
                <title xsi:type="mlm:RawText" text="Parser Training"/>
              </children>
              <children xsi:type="mlm:WrappingNode" transient="true"/>
            </children>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:MarkupList">
              <items xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:WrappingNode">
                  <children xsi:type="mlm:Reference" link="#tools.parser.training.tool" referenced="//@children.0/@children.1/@children.12/@children.3/@children.6/@children.0/@title/@children.0">
                    <title xsi:type="mlm:RawText" text="Training Tool"/>
                  </children>
                  <children xsi:type="mlm:WrappingNode" transient="true"/>
                </children>
                <children xsi:type="mlm:WrappingNode">
                  <children xsi:type="mlm:Reference" link="#tools.parser.training.api" referenced="//@children.0/@children.1/@children.12/@children.3/@children.7/@children.0/@title/@children.0">
                    <title xsi:type="mlm:RawText" text="Training API"/>
                  </children>
                  <children xsi:type="mlm:WrappingNode" transient="true"/>
                </children>
              </items>
            </children>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:Reference" link="#tools.parser.evaluation" referenced="//@children.0/@children.1/@children.12/@children.4/@children.0/@title/@children.0">
                <title xsi:type="mlm:RawText" text="Parser Evaluation"/>
              </children>
              <children xsi:type="mlm:WrappingNode" transient="true"/>
            </children>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:MarkupList">
              <items xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:WrappingNode">
                  <children xsi:type="mlm:Reference" link="#tools.parser.evaluation.tool" referenced="//@children.0/@children.1/@children.12/@children.4/@children.4/@children.0/@title/@children.0">
                    <title xsi:type="mlm:RawText" text="Parser Evaluation Tool"/>
                  </children>
                  <children xsi:type="mlm:WrappingNode" transient="true"/>
                </children>
                <children xsi:type="mlm:WrappingNode">
                  <children xsi:type="mlm:Reference" link="#tools.parser.evaluation.api" referenced="//@children.0/@children.1/@children.12/@children.4/@children.5/@children.0/@title/@children.0">
                    <title xsi:type="mlm:RawText" text="Evaluation API"/>
                  </children>
                  <children xsi:type="mlm:WrappingNode" transient="true"/>
                </children>
              </items>
            </children>
            <children xsi:type="mlm:LineBreak"/>
          </children>
        </children>
        <children xsi:type="mlm:WrappingNode" transient="true">
          <children xsi:type="mlm:Section" level="3">
            <title xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:Anchor" name="tools.parser.parsing"/>
              <children xsi:type="mlm:RawText" text="Parsing"/>
            </title>
          </children>
          <children xsi:type="mlm:LineBreak"/>
          <children xsi:type="mlm:MarkupList">
            <items xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:WrappingNode">
                <children xsi:type="mlm:Reference" link="#tools.parser.parsing.cmdline" referenced="//@children.0/@children.1/@children.12/@children.2/@children.7/@children.0/@title/@children.0">
                  <title xsi:type="mlm:RawText" text="Parser Tool"/>
                </children>
                <children xsi:type="mlm:WrappingNode" transient="true"/>
              </children>
              <children xsi:type="mlm:WrappingNode">
                <children xsi:type="mlm:Reference" link="#tools.parser.parsing.api" referenced="//@children.0/@children.1/@children.12/@children.2/@children.8/@children.0/@title/@children.0">
                  <title xsi:type="mlm:RawText" text="Parsing API"/>
                </children>
                <children xsi:type="mlm:WrappingNode" transient="true"/>
              </children>
            </items>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="A parser returns a parse tree from a sentence according to a phrase structure grammar. A parse tree specifies the internal structure of a sentence. For example, the following image represents a parse tree for the sentence 'The cellphone was broken in two days':"/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:Image" link="images/parsetree1.png"/>
          <children xsi:type="mlm:RawText" text=" "/>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="A parse tree can be used to determine the role of subtrees or constituents in the sentence. For example, it is possible to know that 'The cellphone' is the subject of the sentence and the verb (action) is 'was broken.'"/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:Section" level="4">
              <title xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:Anchor" name="tools.parser.parsing.cmdline"/>
                <children xsi:type="mlm:RawText" text="Parser Tool"/>
              </title>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="The easiest way to try out the Parser is the command line tool. The tool is only intended for demonstration and testing. Download the English chunking parser model from the website and start the Parse Tool with the following command."/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:RawText" text="                                &#xA;$ opennlp Parser en-parser-chunking.bin&#xA;               "/>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="Loading the big parser model can take several seconds, be patient. Copy this sample sentence to the console."/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:RawText" text="                                &#xA;The cellphone was broken in two days .&#xA;               "/>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="The parser should now print the following to the console."/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:RawText" text="                                &#xA;(TOP (S (NP (DT The) (NN cellphone)) (VP (VBD was) (VP (VBN broken) (PP (IN in) (NP (CD two) (NNS days))))) (. .)))&#xA;               "/>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="With the following command the input can be read from a file and be written to an output file."/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:RawText" text="                                &#xA;$ opennlp Parser en-parser-chunking.bin &lt; article-tokenized.txt > article-parsed.txt.&#xA;               "/>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="The article-tokenized.txt file must contain one sentence per line which is tokenized with the English tokenizer model from our website. See the Tokenizer documentation for further details."/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
          </children>
          <children xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:Section" level="4">
              <title xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:Anchor" name="tools.parser.parsing.api"/>
                <children xsi:type="mlm:RawText" text="Parsing API"/>
              </title>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="The Parser can be easily integrated into an application via its API. To instantiate a Parser the parser model must be loaded first."/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:RawText" text="                                &#xA;InputStream modelIn = "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" FileInputStream("/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;en-parser-chunking.bin&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=");&#xA;"/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="try"/>
                </children>
                <children xsi:type="mlm:RawText" text=" {&#xA;  ParserModel model = "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" ParserModel(modelIn);&#xA;}&#xA;"/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="catch"/>
                </children>
                <children xsi:type="mlm:RawText" text=" (IOException e) {&#xA;  e.printStackTrace();&#xA;}&#xA;"/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="finally"/>
                </children>
                <children xsi:type="mlm:RawText" text=" {&#xA;  "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="if"/>
                </children>
                <children xsi:type="mlm:RawText" text=" (modelIn != null) {&#xA;    "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="try"/>
                </children>
                <children xsi:type="mlm:RawText" text=" {&#xA;      modelIn.close();&#xA;    }&#xA;    "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="catch"/>
                </children>
                <children xsi:type="mlm:RawText" text=" (IOException e) {&#xA;    }&#xA;  }&#xA;}&#xA;               "/>
              </content>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="Unlike the other components to instantiate the Parser a factory method should be used instead of creating the Parser via the new operator. The parser model is either trained for the chunking parser or the tree insert parser the parser implementation must be chosen correctly. The factory method will read a type parameter from the model and create an instance of the corresponding parser implementation."/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:RawText" text="                                &#xA;Parser parser = ParserFactory.create(model);&#xA;               "/>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="Right now the tree insert parser is still experimental and there is no pre-trained model for it. The parser expect a whitespace tokenized sentence. A utility method from the command line tool can parse the sentence String. The following code shows how the parser can be called."/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:RawText" text="                                &#xA;String sentence = "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;The quick brown fox jumps over the lazy dog .&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=";&#xA;Parse[] topParses = ParserTool.parseLine(sentence, parser, "/>
                <children xsi:type="mlm:RawText" text="1"/>
                <children xsi:type="mlm:RawText" text=");&#xA;               "/>
              </content>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="The topParses array only contains one parse because the number of parses is set to 1. The Parse object contains the parse tree. To display the parse tree call the show method. It either prints the parse to the console or into a provided StringBuffer. Similar to Exception.printStackTrace."/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="TODO: Extend this section with more information about the Parse object."/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
          </children>
        </children>
        <children xsi:type="mlm:WrappingNode" transient="true">
          <children xsi:type="mlm:Section" level="3">
            <title xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:Anchor" name="tools.parser.training"/>
              <children xsi:type="mlm:RawText" text="Parser Training"/>
            </title>
          </children>
          <children xsi:type="mlm:LineBreak"/>
          <children xsi:type="mlm:MarkupList">
            <items xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:WrappingNode">
                <children xsi:type="mlm:Reference" link="#tools.parser.training.tool" referenced="//@children.0/@children.1/@children.12/@children.3/@children.6/@children.0/@title/@children.0">
                  <title xsi:type="mlm:RawText" text="Training Tool"/>
                </children>
                <children xsi:type="mlm:WrappingNode" transient="true"/>
              </children>
              <children xsi:type="mlm:WrappingNode">
                <children xsi:type="mlm:Reference" link="#tools.parser.training.api" referenced="//@children.0/@children.1/@children.12/@children.3/@children.7/@children.0/@title/@children.0">
                  <title xsi:type="mlm:RawText" text="Training API"/>
                </children>
                <children xsi:type="mlm:WrappingNode" transient="true"/>
              </children>
            </items>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="The OpenNLP offers two different parser implementations, the chunking parser and the treeinsert parser. The later one is still experimental and not recommended for production use. (TODO: Add a section which explains the two different approaches) The training can either be done with the command line tool or the training API. In the first case the training data must be available in the OpenNLP format. Which is the Penn Treebank format, but with the limitation of a sentence per line."/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:CodeListing">
            <content xsi:type="mlm:RawText" text="                                &#xA;(TOP (S (NP-SBJ (DT Some) )(VP (VBP say) (NP (NNP November) ))(. .) ))&#xA;(TOP (S (NP-SBJ (PRP I) )(VP (VBP say) (NP (CD 1992) ))(. .) ('' '') ))&#xA;               "/>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:RawText" text="Penn Treebank annotation guidelines can be found on the "/>
              <children xsi:type="mlm:Reference" link="https://www.ling.upenn.edu/courses/Fall_2003/ling001/penn_treebank_pos.html">
                <title xsi:type="mlm:RawText" text="Penn Treebank home page"/>
              </children>
              <children xsi:type="mlm:RawText" text=". A parser model also contains a pos tagger model, depending on the amount of available training data it is recommended to switch the tagger model against a tagger model which was trained on a larger corpus. The pre-trained parser model provided on the website is doing this to achieve a better performance. (TODO: On which data is the model on the website trained, and say on which data the tagger model is trained)"/>
            </children>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:Section" level="4">
              <title xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:Anchor" name="tools.parser.training.tool"/>
                <children xsi:type="mlm:RawText" text="Training Tool"/>
              </title>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="OpenNLP has a command line tool which is used to train the models available from the model download page on various corpora. The data must be converted to the OpenNLP parser training format, which is shortly explained above. To train the parser a head rules file is also needed. (TODO: Add documentation about the head rules file) Usage of the tool:"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:RawText" text="                                &#xA;$ opennlp ParserTrainer&#xA;Usage: opennlp ParserTrainer -headRules headRulesFile [-parserType CHUNKING|TREEINSERT] \&#xA;                             [-params paramsFile] [-iterations num] [-cutoff num] \&#xA;                             -model modelFile -lang language -data sampleData \&#xA;                             [-encoding charsetName]&#xA;&#xA;Arguments description:&#xA;        -headRules headRulesFile&#xA;                head rules file.&#xA;        -parserType CHUNKING|TREEINSERT&#xA;                one of CHUNKING or TREEINSERT, default is CHUNKING.&#xA;        -params paramsFile&#xA;                training parameters file.&#xA;        -iterations num&#xA;                number of training iterations, ignored if -params is used.&#xA;        -cutoff num&#xA;                minimal number of times a feature must be seen, ignored if -params is used.&#xA;        -model modelFile&#xA;                output model file.&#xA;        -format formatName&#xA;                data format, might have its own parameters.&#xA;        -encoding charsetName&#xA;                encoding for reading and writing text, if absent the system default is used.&#xA;        -lang language&#xA;                language which is being processed.&#xA;        -data sampleData&#xA;                data to be used, usually a file name.&#xA;        -encoding charsetName&#xA;                encoding for reading and writing text, if absent the system default is used.&#xA;       "/>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="The model on the website was trained with the following command:"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:RawText" text="                &#xA;$ opennlp ParserTrainer -model en-parser-chunking.bin -parserType CHUNKING \&#xA;                        -headRules head_rules \&#xA;                        -lang en -data train.all -encoding ISO-8859-1&#xA;    &#xA;               "/>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="Its also possible to specify the cutoff and the number of iterations, these parameters are used for all trained models. The -parserType parameter is an optional parameter, to use the tree insertion parser, specify TREEINSERT as type. The TaggerModelReplacer tool replaces the tagger model inside the parser model with a new one."/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="Note: The original parser model will be overwritten with the new parser model which contains the replaced tagger model."/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:RawText" text="                &#xA;$ opennlp TaggerModelReplacer en-parser-chunking.bin en-pos-maxent.bin&#xA;               "/>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="Additionally there are tools to just retrain the build or the check model."/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
          </children>
          <children xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:Section" level="4">
              <title xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:Anchor" name="tools.parser.training.api"/>
                <children xsi:type="mlm:RawText" text="Training API"/>
              </title>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="The Parser training API supports the training of a new parser model. Four steps are necessary to train it:"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:WrappingNode">
                <children xsi:type="mlm:LineBreak"/>
                <children xsi:type="mlm:RawText" text="A HeadRules class needs to be instantiated: currently EnglishHeadRules and AncoraSpanishHeadRules are available."/>
                <children xsi:type="mlm:LineBreak"/>
              </children>
              <children xsi:type="mlm:WrappingNode">
                <children xsi:type="mlm:LineBreak"/>
                <children xsi:type="mlm:RawText" text="The application must open a sample data stream."/>
                <children xsi:type="mlm:LineBreak"/>
              </children>
              <children xsi:type="mlm:WrappingNode">
                <children xsi:type="mlm:LineBreak"/>
                <children xsi:type="mlm:RawText" text="Call a Parser train method: This can be either the CHUNKING or the TREEINSERT parser."/>
                <children xsi:type="mlm:LineBreak"/>
              </children>
              <children xsi:type="mlm:WrappingNode">
                <children xsi:type="mlm:LineBreak"/>
                <children xsi:type="mlm:RawText" text="Save the ParseModel to a file"/>
                <children xsi:type="mlm:LineBreak"/>
              </children>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="The following code snippet shows how to instantiate the HeadRules:"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:RawText" text="                                &#xA;"/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="static"/>
                </children>
                <children xsi:type="mlm:RawText" text=" HeadRules createHeadRules(TrainerToolParams params) "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="throws"/>
                </children>
                <children xsi:type="mlm:RawText" text=" IOException {&#xA;&#xA;    ArtifactSerializer headRulesSerializer = null;&#xA;&#xA;    "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="if"/>
                </children>
                <children xsi:type="mlm:RawText" text=" (params.getHeadRulesSerializerImpl() != null) {&#xA;      headRulesSerializer = ExtensionLoader.instantiateExtension(ArtifactSerializer."/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="class"/>
                </children>
                <children xsi:type="mlm:RawText" text=",&#xA;              params.getHeadRulesSerializerImpl());&#xA;    }&#xA;    "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="else"/>
                </children>
                <children xsi:type="mlm:RawText" text=" {&#xA;      "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="if"/>
                </children>
                <children xsi:type="mlm:RawText" text=" ("/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;eng&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=".equals(params.getLang())) {&#xA;        headRulesSerializer = "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" opennlp.tools.parser.lang.en.HeadRules.HeadRulesSerializer();&#xA;      }&#xA;      "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="else"/>
                </children>
                <children xsi:type="mlm:RawText" text=" "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="if"/>
                </children>
                <children xsi:type="mlm:RawText" text=" ("/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;es&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=".equals(params.getLang())) {&#xA;        headRulesSerializer = "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" opennlp.tools.parser.lang.es.AncoraSpanishHeadRules.HeadRulesSerializer();&#xA;      }&#xA;      "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="else"/>
                </children>
                <children xsi:type="mlm:RawText" text=" {&#xA;        "/>
                <children xsi:type="mlm:Emphasized">
                  <parts xsi:type="mlm:RawText" text="// default for now, this case should probably cause an error ..."/>
                </children>
                <children xsi:type="mlm:RawText" text="&#xA;        headRulesSerializer = "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" opennlp.tools.parser.lang.en.HeadRules.HeadRulesSerializer();&#xA;      }&#xA;    }&#xA;&#xA;    Object headRulesObject = headRulesSerializer.create("/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" FileInputStream(params.getHeadRules()));&#xA;&#xA;    "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="if"/>
                </children>
                <children xsi:type="mlm:RawText" text=" (headRulesObject "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="instanceof"/>
                </children>
                <children xsi:type="mlm:RawText" text=" HeadRules) {&#xA;      "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="return"/>
                </children>
                <children xsi:type="mlm:RawText" text=" (HeadRules) headRulesObject;&#xA;    }&#xA;    "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="else"/>
                </children>
                <children xsi:type="mlm:RawText" text=" {&#xA;      "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="throw"/>
                </children>
                <children xsi:type="mlm:RawText" text=" "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" TerminateToolException(-"/>
                <children xsi:type="mlm:RawText" text="1"/>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;HeadRules Artifact Serializer must create an object of type HeadRules!&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=");&#xA;    }&#xA;}&#xA;       "/>
              </content>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="The following code illustrates the three other steps, namely, opening the data, training the model and saving the ParserModel into an output file."/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:RawText" text="                                &#xA;ParserModel model = null;&#xA;File modelOutFile = params.getModel();&#xA;CmdLineUtil.checkOutputFile("/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;parser model&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", modelOutFile);&#xA;&#xA;"/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="try"/>
                </children>
                <children xsi:type="mlm:RawText" text=" {&#xA;  HeadRules rules = createHeadRules(params);&#xA;  InputStreamFactory inputStreamFactory = "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" MarkableFileInputStreamFactory("/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" File("/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;parsing.train&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text="));&#xA;  ObjectStream&lt;String> stringStream = "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" PlainTextByLineStream(inputStreamFactory, StandardCharsets.UTF_"/>
                <children xsi:type="mlm:RawText" text="8"/>
                <children xsi:type="mlm:RawText" text=");&#xA;  ObjectStream&lt;Parse> sampleStream = "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" ParseSample(stringStream);&#xA;&#xA;  ParserType type = parseParserType(params.getParserType());&#xA;  "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="if"/>
                </children>
                <children xsi:type="mlm:RawText" text=" (ParserType.CHUNKING.equals(type)) {&#xA;    model = opennlp.tools.parser.chunking.Parser.train(&#xA;            params.getLang(), sampleStream, rules,&#xA;            mlParams);&#xA;  } "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="else"/>
                </children>
                <children xsi:type="mlm:RawText" text=" "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="if"/>
                </children>
                <children xsi:type="mlm:RawText" text=" (ParserType.TREEINSERT.equals(type)) {&#xA;    model = opennlp.tools.parser.treeinsert.Parser.train(params.getLang(), sampleStream, rules,&#xA;            mlParams);&#xA;    }&#xA;  }&#xA;  "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="catch"/>
                </children>
                <children xsi:type="mlm:RawText" text=" (IOException e) {&#xA;      "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="throw"/>
                </children>
                <children xsi:type="mlm:RawText" text=" "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" TerminateToolException(-"/>
                <children xsi:type="mlm:RawText" text="1"/>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;IO error while reading training data or indexing data: &quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text="&#xA;          + e.getMessage(), e);&#xA;  }&#xA;  "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="finally"/>
                </children>
                <children xsi:type="mlm:RawText" text=" {&#xA;      "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="try"/>
                </children>
                <children xsi:type="mlm:RawText" text=" {&#xA;        sampleStream.close();&#xA;      }&#xA;      "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="catch"/>
                </children>
                <children xsi:type="mlm:RawText" text=" (IOException e) {&#xA;        "/>
                <children xsi:type="mlm:Emphasized">
                  <parts xsi:type="mlm:RawText" text="// sorry that this can fail"/>
                </children>
                <children xsi:type="mlm:RawText" text="&#xA;      }&#xA;  }&#xA;  CmdLineUtil.writeModel("/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;parser&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", modelOutFile, model);&#xA;&#xA;       "/>
              </content>
            </children>
          </children>
        </children>
        <children xsi:type="mlm:WrappingNode" transient="true">
          <children xsi:type="mlm:Section" level="3">
            <title xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:Anchor" name="tools.parser.evaluation"/>
              <children xsi:type="mlm:RawText" text="Parser Evaluation"/>
            </title>
          </children>
          <children xsi:type="mlm:LineBreak"/>
          <children xsi:type="mlm:MarkupList">
            <items xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:WrappingNode">
                <children xsi:type="mlm:Reference" link="#tools.parser.evaluation.tool" referenced="//@children.0/@children.1/@children.12/@children.4/@children.4/@children.0/@title/@children.0">
                  <title xsi:type="mlm:RawText" text="Parser Evaluation Tool"/>
                </children>
                <children xsi:type="mlm:WrappingNode" transient="true"/>
              </children>
              <children xsi:type="mlm:WrappingNode">
                <children xsi:type="mlm:Reference" link="#tools.parser.evaluation.api" referenced="//@children.0/@children.1/@children.12/@children.4/@children.5/@children.0/@title/@children.0">
                  <title xsi:type="mlm:RawText" text="Evaluation API"/>
                </children>
                <children xsi:type="mlm:WrappingNode" transient="true"/>
              </children>
            </items>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="The built in evaluation can measure the parser performance. The performance is measured on a test dataset."/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:Section" level="4">
              <title xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:Anchor" name="tools.parser.evaluation.tool"/>
                <children xsi:type="mlm:RawText" text="Parser Evaluation Tool"/>
              </title>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="The following command shows how the tool can be run:"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:RawText" text="                                &#xA;$ opennlp ParserEvaluator&#xA;Usage: opennlp ParserEvaluator[.ontonotes|frenchtreebank] [-misclassified true|false] -model model \&#xA;               -data sampleData [-encoding charsetName]&#xA;               "/>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="A sample of the command considering you have a data sample named en-parser-chunking.eval, and you trained a model called en-parser-chunking.bin:"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:RawText" text="                                &#xA;$ opennlp ParserEvaluator -model en-parser-chunking.bin -data en-parser-chunking.eval -encoding UTF-8&#xA;               "/>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="and here is a sample output:"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:RawText" text="                &#xA;Precision: 0.9009744742967609&#xA;Recall: 0.8962012400910446&#xA;F-Measure: 0.8985815184245214&#xA;               "/>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:RawText" text="The Parser Evaluation tool reimplements the PARSEVAL scoring method as implemented by the "/>
                <children xsi:type="mlm:Reference" link="http://nlp.cs.nyu.edu/evalb/">
                  <title xsi:type="mlm:RawText" text="EVALB"/>
                </children>
                <children xsi:type="mlm:RawText" text=" script, which is the most widely used evaluation tool for constituent parsing. Note however that currently the Parser Evaluation tool does not allow to make exceptions in the constituents to be evaluated, in the way Collins or Bikel usually do. Any contributions are very welcome. If you want to contribute please contact us on the mailing list or comment on the jira issue "/>
                <children xsi:type="mlm:Reference" link="https://issues.apache.org/jira/browse/OPENNLP-688">
                  <title xsi:type="mlm:RawText" text="OPENNLP-688"/>
                </children>
                <children xsi:type="mlm:RawText" text="."/>
              </children>
              <children xsi:type="mlm:LineBreak"/>
            </children>
          </children>
          <children xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:Section" level="4">
              <title xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:Anchor" name="tools.parser.evaluation.api"/>
                <children xsi:type="mlm:RawText" text="Evaluation API"/>
              </title>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="The evaluation can be performed on a pre-trained model and a test dataset or via cross validation. In the first case the model must be loaded and a Parse ObjectStream must be created (see code samples above), assuming these two objects exist the following code shows how to perform the evaluation:"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:RawText" text="                          &#xA;Parser parser = ParserFactory.create(model);&#xA;ParserEvaluator evaluator = "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" ParserEvaluator(parser);&#xA;evaluator.evaluate(sampleStream);&#xA;&#xA;FMeasure result = evaluator.getFMeasure();&#xA;&#xA;System.out.println(result.toString());&#xA;                       "/>
              </content>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="In the cross validation case all the training arguments must be provided (see the Training API section above). To perform cross validation the ObjectStream must be resettable."/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:RawText" text="                                &#xA;InputStreamFactory inputStreamFactory = "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" MarkableFileInputStreamFactory("/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" File("/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;parsing.train&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text="));&#xA;ObjectStream&lt;String> stringStream = "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" PlainTextByLineStream(inputStreamFactory, StandardCharsets.UTF_"/>
                <children xsi:type="mlm:RawText" text="8"/>
                <children xsi:type="mlm:RawText" text=");&#xA;ObjectStream&lt;Parse> sampleStream = "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" ParseSample(stringStream);&#xA;ParserCrossValidator evaluator = "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" ParserCrossValidator("/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;eng&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", trainParameters, headRules, \&#xA;parserType, listeners.toArray("/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" ParserEvaluationMonitor[listeners.size()])));&#xA;evaluator.evaluate(sampleStream, "/>
                <children xsi:type="mlm:RawText" text="10"/>
                <children xsi:type="mlm:RawText" text=");&#xA;&#xA;FMeasure result = evaluator.getFMeasure();&#xA;&#xA;System.out.println(result.toString());&#xA;                       "/>
              </content>
            </children>
          </children>
        </children>
      </children>
      <children xsi:type="mlm:WrappingNode" transient="true">
        <children xsi:type="mlm:Section" level="2">
          <title xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:Anchor" name="tools.coref"/>
            <children xsi:type="mlm:RawText" text="Chapter&#xa0;11.&#xa0;Coreference Resolution"/>
          </title>
        </children>
        <children xsi:type="mlm:WrappingNode">
          <children xsi:type="mlm:LineBreak"/>
          <children xsi:type="mlm:RawText" text="The OpenNLP Coreference Resolution system links multiple mentions of an entity in a document together. The OpenNLP implementation is currently limited to noun phrase mentions, other mention types cannot be resolved."/>
          <children xsi:type="mlm:LineBreak"/>
        </children>
        <children xsi:type="mlm:WrappingNode">
          <children xsi:type="mlm:LineBreak"/>
          <children xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:RawText" text="TODO: Write more documentation about the coref component. Any contributions are very welcome. If you want to contribute please contact us on the mailing list or comment on the jira issue "/>
            <children xsi:type="mlm:Reference" link="https://issues.apache.org/jira/browse/OPENNLP-48">
              <title xsi:type="mlm:RawText" text="OPENNLP-48"/>
            </children>
            <children xsi:type="mlm:RawText" text="."/>
          </children>
          <children xsi:type="mlm:LineBreak"/>
        </children>
      </children>
      <children xsi:type="mlm:WrappingNode" transient="true">
        <children xsi:type="mlm:Section" level="2">
          <title xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:Anchor" name="tools.model"/>
            <children xsi:type="mlm:RawText" text="Chapter&#xa0;12.&#xa0;Classpath Loading of OpenNLP Models"/>
          </title>
        </children>
        <children xsi:type="mlm:Section" level="5">
          <title xsi:type="mlm:Emphasized" type="BOLD">
            <parts xsi:type="mlm:RawText" text="Table of Contents"/>
          </title>
          <children xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:Reference" link="#tools.model.load" referenced="//@children.0/@children.1/@children.14/@children.4/@children.0/@title/@children.0">
                <title xsi:type="mlm:RawText" text="Loading a pre-trained OpenNLP model from the classpath"/>
              </children>
              <children xsi:type="mlm:WrappingNode" transient="true"/>
            </children>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:Reference" link="#tools.model.bundle" referenced="//@children.0/@children.1/@children.14/@children.5/@children.0/@title/@children.0">
                <title xsi:type="mlm:RawText" text="Bundling a custom trained OpenNLP model for the classpath"/>
              </children>
              <children xsi:type="mlm:WrappingNode" transient="true"/>
            </children>
            <children xsi:type="mlm:LineBreak"/>
          </children>
        </children>
        <children xsi:type="mlm:WrappingNode">
          <children xsi:type="mlm:LineBreak"/>
          <children xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:RawText" text="Since version 2.4.0, OpenNLP supports the ability to load pre-trained OpenNLP models from the classpath. It relies on either a simple implementation using the application's classpath or on the "/>
            <children xsi:type="mlm:Reference" link="https://github.com/classgraph/classgraph">
              <title xsi:type="mlm:RawText" text="classgraph"/>
            </children>
            <children xsi:type="mlm:RawText" text=" library to locate OpenNLP model JAR files. Our pre-trained models are bundled from the "/>
            <children xsi:type="mlm:Reference" link="https://github.com/apache/opennlp-models">
              <title xsi:type="mlm:RawText" text="OpenNLP Models repository"/>
            </children>
            <children xsi:type="mlm:RawText" text=". This section describes"/>
          </children>
          <children xsi:type="mlm:LineBreak"/>
        </children>
        <children xsi:type="mlm:WrappingNode" transient="true">
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="how to load and use a pre-trained OpenNLP model from the classpath."/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="how to bundle a custom OpenNLP model to be loadable as a JAR file from the classpath."/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
        </children>
        <children xsi:type="mlm:WrappingNode" transient="true">
          <children xsi:type="mlm:Section" level="3">
            <title xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:Anchor" name="tools.model.load"/>
              <children xsi:type="mlm:RawText" text="Loading a pre-trained OpenNLP model from the classpath"/>
            </title>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="First, you need to add the following dependency to your classpath:"/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:CodeListing">
            <content xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:RawText" text="                &#xA;"/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="&lt;dependency>"/>
              </children>
              <children xsi:type="mlm:RawText" text="&#xA;  "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="&lt;groupId>"/>
              </children>
              <children xsi:type="mlm:RawText" text="org.apache.opennlp"/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="&lt;/groupId>"/>
              </children>
              <children xsi:type="mlm:RawText" text="&#xA;  "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="&lt;artifactId>"/>
              </children>
              <children xsi:type="mlm:RawText" text="opennlp-tools-models"/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="&lt;/artifactId>"/>
              </children>
              <children xsi:type="mlm:RawText" text="&#xA;  "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="&lt;version>"/>
              </children>
              <children xsi:type="mlm:RawText" text="CURRENT_OPENNLP_VERSION"/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="&lt;/version>"/>
              </children>
              <children xsi:type="mlm:RawText" text="&#xA;"/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="&lt;/dependency>"/>
              </children>
              <children xsi:type="mlm:RawText" text="&#xA;&#xA;           "/>
            </content>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="by using our pre-trained models or by building custom models as described later in this section. If you need advanced classpath scanning capabilities, you can also add the classgraph library to your classpath."/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:CodeListing">
            <content xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:RawText" text="                &#xA;"/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="&lt;dependency>"/>
              </children>
              <children xsi:type="mlm:RawText" text="&#xA;    "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="&lt;groupId>"/>
              </children>
              <children xsi:type="mlm:RawText" text="io.github.classgraph"/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="&lt;/groupId>"/>
              </children>
              <children xsi:type="mlm:RawText" text="&#xA;    "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="&lt;artifactId>"/>
              </children>
              <children xsi:type="mlm:RawText" text="classgraph"/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="&lt;/artifactId>"/>
              </children>
              <children xsi:type="mlm:RawText" text="&#xA;    "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="&lt;version>"/>
              </children>
              <children xsi:type="mlm:RawText" text="CURRENT_CLASSGRAPH_VERSION"/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="&lt;/version>"/>
              </children>
              <children xsi:type="mlm:RawText" text="&#xA;"/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="&lt;/dependency>"/>
              </children>
              <children xsi:type="mlm:RawText" text="&#xA;&#xA;           "/>
            </content>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="Make sure you replace the placeholders with the appropriate version values. Next, you can search for such a model and load it from the classpath:"/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:CodeListing">
            <content xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:RawText" text="                &#xA;"/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="final"/>
              </children>
              <children xsi:type="mlm:RawText" text=" ClassgraphModelFinder finder = "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="new"/>
              </children>
              <children xsi:type="mlm:RawText" text=" ClassgraphModelFinder(); "/>
              <children xsi:type="mlm:Emphasized">
                <parts xsi:type="mlm:RawText" text="// or use: new SimpleClassPathModelFinder()"/>
              </children>
              <children xsi:type="mlm:RawText" text="&#xA;"/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="final"/>
              </children>
              <children xsi:type="mlm:RawText" text=" ClassPathModelLoader loader = "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="new"/>
              </children>
              <children xsi:type="mlm:RawText" text=" ClassPathModelLoader();&#xA;"/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="final"/>
              </children>
              <children xsi:type="mlm:RawText" text=" Set&lt;ClassPathModelEntry> models = finder.findModels(false);&#xA;"/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="for"/>
              </children>
              <children xsi:type="mlm:RawText" text="(ClassPathModelEntry entry : models) {&#xA;&#xA;   "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="final"/>
              </children>
              <children xsi:type="mlm:RawText" text=" ClassPathModel model = loader.load(entry);&#xA;&#xA;   "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="if"/>
              </children>
              <children xsi:type="mlm:RawText" text="(model != null) {&#xA;      System.out.println(model.getModelName());&#xA;      System.out.println(model.getModelSHA2"/>
              <children xsi:type="mlm:RawText" text="56"/>
              <children xsi:type="mlm:RawText" text="());&#xA;      System.out.println(model.getModelVersion());&#xA;      System.out.println(model.getModelLanguage());&#xA;      "/>
              <children xsi:type="mlm:Emphasized">
                <parts xsi:type="mlm:RawText" text="// do something with the model by consuming the byte array"/>
              </children>
              <children xsi:type="mlm:RawText" text="&#xA;   }&#xA;}&#xA;           "/>
            </content>
          </children>
        </children>
        <children xsi:type="mlm:WrappingNode" transient="true">
          <children xsi:type="mlm:Section" level="3">
            <title xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:Anchor" name="tools.model.bundle"/>
              <children xsi:type="mlm:RawText" text="Bundling a custom trained OpenNLP model for the classpath"/>
            </title>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:RawText" text="If you intend to provide your own custom trained OpenNLP models as JAR files for classpath discovery, we recommend that you have a look at our setup in the "/>
              <children xsi:type="mlm:Reference" link="https://github.com/apache/opennlp-models">
                <title xsi:type="mlm:RawText" text="OpenNLP Models repository"/>
              </children>
              <children xsi:type="mlm:RawText" text=". We recommend to bundle one model per JAR file. Make sure you add a "/>
              <children xsi:type="mlm:Emphasized">
                <parts xsi:type="mlm:RawText" text="model.properties"/>
              </children>
              <children xsi:type="mlm:RawText" text=" file with the following content"/>
            </children>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:CodeListing">
            <content xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:RawText" text="                &#xA;model.name=${model.name}&#xA;model.version=${model.version}&#xA;model.sha2"/>
              <children xsi:type="mlm:RawText" text="56"/>
              <children xsi:type="mlm:RawText" text="=${model.sha2"/>
              <children xsi:type="mlm:RawText" text="56"/>
              <children xsi:type="mlm:RawText" text="}&#xA;model.language=${model.language}&#xA;&#xA;           "/>
            </content>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:RawText" text="Make sure to replace the values accordingly and configure your build tool to include the binary model and the "/>
              <children xsi:type="mlm:Emphasized">
                <parts xsi:type="mlm:RawText" text="model.properties"/>
              </children>
              <children xsi:type="mlm:RawText" text=" in the resulting JAR file. To load such a custom model, you may need to adjust the pattern for classpath scanning. For example, if you name the model &quot;custom-opennlp-model&quot;, you need the following code to successfully find and load it:"/>
            </children>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:CodeListing">
            <content xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:RawText" text="                &#xA;"/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="final"/>
              </children>
              <children xsi:type="mlm:RawText" text=" ClassgraphModelFinder finder = "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="new"/>
              </children>
              <children xsi:type="mlm:RawText" text=" ClassgraphModelFinder("/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:Emphasized">
                  <parts xsi:type="mlm:RawText" text="&quot;custom-opennlp-model.jar&quot;"/>
                </parts>
              </children>
              <children xsi:type="mlm:RawText" text="); "/>
              <children xsi:type="mlm:Emphasized">
                <parts xsi:type="mlm:RawText" text="// or use: new SimpleClassPathModelFinder(&quot;custom-opennlp-model.jar&quot;)"/>
              </children>
              <children xsi:type="mlm:RawText" text="&#xA;"/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="final"/>
              </children>
              <children xsi:type="mlm:RawText" text=" ClassPathModelLoader loader = "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="new"/>
              </children>
              <children xsi:type="mlm:RawText" text=" ClassPathModelLoader();&#xA;"/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="final"/>
              </children>
              <children xsi:type="mlm:RawText" text=" Set&lt;ClassPathModelEntry> models = finder.findModels(false);&#xA;"/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="for"/>
              </children>
              <children xsi:type="mlm:RawText" text="(ClassPathModelEntry entry : models) {&#xA;&#xA;   "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="final"/>
              </children>
              <children xsi:type="mlm:RawText" text=" ClassPathModel model = loader.load(entry);&#xA;&#xA;   "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="if"/>
              </children>
              <children xsi:type="mlm:RawText" text="(model != null) {&#xA;      System.out.println(model.getModelName());&#xA;      System.out.println(model.getModelSHA2"/>
              <children xsi:type="mlm:RawText" text="56"/>
              <children xsi:type="mlm:RawText" text="());&#xA;      System.out.println(model.getModelVersion());&#xA;      System.out.println(model.getModelLanguage());&#xA;      "/>
              <children xsi:type="mlm:Emphasized">
                <parts xsi:type="mlm:RawText" text="// do something with the model by consuming the byte array"/>
              </children>
              <children xsi:type="mlm:RawText" text="&#xA;   }&#xA;}&#xA;           "/>
            </content>
          </children>
        </children>
      </children>
      <children xsi:type="mlm:WrappingNode" transient="true">
        <children xsi:type="mlm:Section" level="2">
          <title xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:Anchor" name="tools.extension"/>
            <children xsi:type="mlm:RawText" text="Chapter&#xa0;13.&#xa0;Extending OpenNLP"/>
          </title>
        </children>
        <children xsi:type="mlm:Section" level="5">
          <title xsi:type="mlm:Emphasized" type="BOLD">
            <parts xsi:type="mlm:RawText" text="Table of Contents"/>
          </title>
          <children xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:Reference" link="#tools.extension.writing" referenced="//@children.0/@children.1/@children.15/@children.3/@children.0/@title/@children.0">
                <title xsi:type="mlm:RawText" text="Writing an extension"/>
              </children>
              <children xsi:type="mlm:WrappingNode" transient="true"/>
            </children>
            <children xsi:type="mlm:LineBreak"/>
          </children>
        </children>
        <children xsi:type="mlm:WrappingNode">
          <children xsi:type="mlm:LineBreak"/>
          <children xsi:type="mlm:RawText" text="In OpenNLP extension can be used to add new functionality and to heavily customize an existing component. Most components define a factory class which can be implemented to customize the creation of it. And some components allow to add new feature generators."/>
          <children xsi:type="mlm:LineBreak"/>
        </children>
        <children xsi:type="mlm:WrappingNode" transient="true">
          <children xsi:type="mlm:Section" level="3">
            <title xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:Anchor" name="tools.extension.writing"/>
              <children xsi:type="mlm:RawText" text="Writing an extension"/>
            </title>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="In many places it is possible to pass in an extension class name to customize some aspect of OpenNLP. The implementation class needs to implement the specified interface and should have a public no-argument constructor."/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
        </children>
      </children>
      <children xsi:type="mlm:WrappingNode" transient="true">
        <children xsi:type="mlm:Section" level="2">
          <title xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:Anchor" name="tools.corpora"/>
            <children xsi:type="mlm:RawText" text="Chapter&#xa0;14.&#xa0;Corpora"/>
          </title>
        </children>
        <children xsi:type="mlm:Section" level="5">
          <title xsi:type="mlm:Emphasized" type="BOLD">
            <parts xsi:type="mlm:RawText" text="Table of Contents"/>
          </title>
          <children xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:Reference" link="#tools.corpora.conll" referenced="//@children.0/@children.1/@children.16/@children.3/@children.0/@title/@children.0">
                <title xsi:type="mlm:RawText" text="CONLL"/>
              </children>
              <children xsi:type="mlm:WrappingNode" transient="true"/>
            </children>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:MarkupList">
              <items xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:WrappingNode">
                  <children xsi:type="mlm:Reference" link="#tools.corpora.conll.2000" referenced="//@children.0/@children.1/@children.16/@children.3/@children.4/@children.0/@title/@children.0">
                    <title xsi:type="mlm:RawText" text="CONLL 2000"/>
                  </children>
                  <children xsi:type="mlm:LineBreak"/>
                  <children xsi:type="mlm:MarkupList">
                    <items xsi:type="mlm:WrappingNode" transient="true">
                      <children xsi:type="mlm:WrappingNode">
                        <children xsi:type="mlm:Reference" link="#tools.corpora.conll.2000.getting" referenced="//@children.0/@children.1/@children.16/@children.3/@children.4/@children.4/@children.0/@children.0">
                          <title xsi:type="mlm:RawText" text="Getting the data"/>
                        </children>
                        <children xsi:type="mlm:WrappingNode" transient="true"/>
                      </children>
                      <children xsi:type="mlm:WrappingNode">
                        <children xsi:type="mlm:Reference" link="#tools.corpora.conll.2000.converting" referenced="//@children.0/@children.1/@children.16/@children.3/@children.4/@children.5/@children.0/@children.0">
                          <title xsi:type="mlm:RawText" text="Converting the data"/>
                        </children>
                        <children xsi:type="mlm:WrappingNode" transient="true"/>
                      </children>
                      <children xsi:type="mlm:WrappingNode">
                        <children xsi:type="mlm:Reference" link="#tools.corpora.conll.2000.training" referenced="//@children.0/@children.1/@children.16/@children.3/@children.4/@children.6/@children.0/@children.0">
                          <title xsi:type="mlm:RawText" text="Training"/>
                        </children>
                        <children xsi:type="mlm:WrappingNode" transient="true"/>
                      </children>
                      <children xsi:type="mlm:WrappingNode">
                        <children xsi:type="mlm:Reference" link="#tools.corpora.conll.2000.evaluation" referenced="//@children.0/@children.1/@children.16/@children.3/@children.4/@children.7/@children.0/@children.0">
                          <title xsi:type="mlm:RawText" text="Evaluating"/>
                        </children>
                        <children xsi:type="mlm:WrappingNode" transient="true"/>
                      </children>
                    </items>
                  </children>
                </children>
                <children xsi:type="mlm:WrappingNode">
                  <children xsi:type="mlm:Reference" link="#tools.corpora.conll.2002" referenced="//@children.0/@children.1/@children.16/@children.3/@children.5/@children.0/@title/@children.0">
                    <title xsi:type="mlm:RawText" text="CONLL 2002"/>
                  </children>
                  <children xsi:type="mlm:LineBreak"/>
                  <children xsi:type="mlm:MarkupList">
                    <items xsi:type="mlm:WrappingNode" transient="true">
                      <children xsi:type="mlm:WrappingNode">

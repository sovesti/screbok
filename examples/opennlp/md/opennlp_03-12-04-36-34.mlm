          </title>
          <children xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:Reference" link="#tools.namefind.recognition" referenced="//@children.0/@children.1/@children.7/@children.2/@children.0/@title/@children.0">
                <title xsi:type="mlm:RawText" text="Named Entity Recognition"/>
              </children>
              <children xsi:type="mlm:WrappingNode" transient="true"/>
            </children>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:LineBreak"/>

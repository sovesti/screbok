            </title>
          </children>
          <children xsi:type="mlm:LineBreak"/>
          <children xsi:type="mlm:MarkupList">
            <items xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:Reference" link="#tools.cli.entitylinker.EntityLinker" referenced="//@children.0/@children.1/@children.20/@children.13/@children.3/@children.0/@title/@children.0">
                <title xsi:type="mlm:RawText" text="EntityLinker"/>
              </children>
              <children xsi:type="mlm:WrappingNode" transient="true"/>
            </items>
          </children>
          <children xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:Section" level="4">
              <title xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:Anchor" name="tools.cli.entitylinker.EntityLinker"/>
                <children xsi:type="mlm:RawText" text="EntityLinker"/>
              </title>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="Links an entity to an external data set"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:RawText" text="Usage: opennlp EntityLinker model &lt; sentences&#xA;&#xA;&#xA;"/>
            </children>
          </children>
        </children>
        <children xsi:type="mlm:WrappingNode" transient="true">
          <children xsi:type="mlm:Section" level="3">
            <title xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:Anchor" name="tools.cli.languagemodel"/>
              <children xsi:type="mlm:RawText" text="Languagemodel"/>
            </title>
          </children>
          <children xsi:type="mlm:LineBreak"/>
          <children xsi:type="mlm:MarkupList">
            <items xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:Reference" link="#tools.cli.languagemodel.NGramLanguageModel" referenced="//@children.0/@children.1/@children.20/@children.14/@children.3/@children.0/@title/@children.0">
                <title xsi:type="mlm:RawText" text="NGramLanguageModel"/>
              </children>
              <children xsi:type="mlm:WrappingNode" transient="true"/>
            </items>
          </children>
          <children xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:Section" level="4">
              <title xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:Anchor" name="tools.cli.languagemodel.NGramLanguageModel"/>
                <children xsi:type="mlm:RawText" text="NGramLanguageModel"/>
              </title>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="Gives the probability and most probable next token(s) of a sequence of tokens in a language model"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:RawText" text="Usage: opennlp NGramLanguageModel model&#xA;&#xA;&#xA;"/>
            </children>
          </children>
        </children>
      </children>
      <children xsi:type="mlm:WrappingNode" transient="true">
        <children xsi:type="mlm:Section" level="2">
          <title xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:Anchor" name="opennlp.evaltest"/>
            <children xsi:type="mlm:RawText" text="Chapter&#xa0;19.&#xa0;Evaluation Test Data"/>
          </title>
        </children>
        <children xsi:type="mlm:Section" level="5">
          <title xsi:type="mlm:Emphasized" type="BOLD">
            <parts xsi:type="mlm:RawText" text="Table of Contents"/>
          </title>
          <children xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:Reference" link="#opennlp.evaltest.whatisit" referenced="//@children.0/@children.1/@children.21/@children.2/@children.0/@title/@children.0">
                <title xsi:type="mlm:RawText" text="What is it ?"/>
              </children>
              <children xsi:type="mlm:WrappingNode" transient="true"/>
            </children>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:Reference" link="#opennlp.evaltest.whereisit" referenced="//@children.0/@children.1/@children.21/@children.3/@children.0/@title/@children.0">
                <title xsi:type="mlm:RawText" text="Where is it?"/>
              </children>
              <children xsi:type="mlm:WrappingNode" transient="true"/>
            </children>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:Reference" link="#opennlp.evaltest.howtouseit" referenced="//@children.0/@children.1/@children.21/@children.4/@children.0/@title/@children.0">
                <title xsi:type="mlm:RawText" text="How to use the evaluation test data to run test?"/>
              </children>
              <children xsi:type="mlm:WrappingNode" transient="true"/>
            </children>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:Reference" link="#opennlp.evaltest.howtochangeit" referenced="//@children.0/@children.1/@children.21/@children.5/@children.0/@title/@children.0">
                <title xsi:type="mlm:RawText" text="How to change evaluation data?"/>
              </children>
              <children xsi:type="mlm:WrappingNode" transient="true"/>
            </children>
            <children xsi:type="mlm:LineBreak"/>
          </children>
        </children>
        <children xsi:type="mlm:WrappingNode" transient="true">
          <children xsi:type="mlm:Section" level="3">
            <title xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:Anchor" name="opennlp.evaltest.whatisit"/>
              <children xsi:type="mlm:RawText" text="What is it ?"/>
            </title>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="The evaluation test data is the data used in the tests that evaluate functionality and performance of OpenNLP. These tests ensure reliability and can help identify potential bugs, errors, or performance issues."/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:RawText" text="The evaluation tests leverage the k-fold cross-validation procedure. This technique works by dividing the evaluation data into "/>
              <children xsi:type="mlm:RawText" text="k"/>
              <children xsi:type="mlm:RawText" text=" equally sized parts or folds. The algorithm is then trained on "/>
              <children xsi:type="mlm:RawText" text="k-1"/>
              <children xsi:type="mlm:RawText" text=" of the folds and tested on the remaining fold. This process is repeated "/>
              <children xsi:type="mlm:RawText" text="k"/>
              <children xsi:type="mlm:RawText" text=" times, so that each of the k-folds is used exactly once as the test data, and the results of each fold are combined to produce an overall estimate of the algorithm's performance."/>
            </children>
            <children xsi:type="mlm:LineBreak"/>
          </children>
        </children>
        <children xsi:type="mlm:WrappingNode" transient="true">
          <children xsi:type="mlm:Section" level="3">
            <title xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:Anchor" name="opennlp.evaltest.whereisit"/>
              <children xsi:type="mlm:RawText" text="Where is it?"/>
            </title>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:RawText" text="OpenNLP evaluation tests data is available at "/>
              <children xsi:type="mlm:Reference" link="https://nightlies.apache.org/opennlp/">
                <title xsi:type="mlm:RawText" text="https://nightlies.apache.org/opennlp/"/>
              </children>
              <children xsi:type="mlm:RawText" text=" (file name : "/>
              <children xsi:type="mlm:RawText" text="opennlp-data.zip"/>
              <children xsi:type="mlm:RawText" text=")"/>
            </children>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:RawText" text="Here's a link to the evaluation-tests build on Jenkins: "/>
              <children xsi:type="mlm:Reference" link="https://builds.apache.org/job/OpenNLP/">
                <title xsi:type="mlm:RawText" text="https://builds.apache.org/job/OpenNLP/"/>
              </children>
            </children>
            <children xsi:type="mlm:LineBreak"/>
          </children>
        </children>
        <children xsi:type="mlm:WrappingNode" transient="true">
          <children xsi:type="mlm:Section" level="3">
            <title xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:Anchor" name="opennlp.evaltest.howtouseit"/>
              <children xsi:type="mlm:RawText" text="How to use the evaluation test data to run test?"/>
            </title>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="The evaluation tests data can be downloaded and saved in the desired directory and can be used to run OpenNLP Evaluation Tests as below:"/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:CodeListing">
            <content xsi:type="mlm:RawText" text="                        &#xA;mvn test -DOPENNLP_DATA_DIR=/path/to/opennlp-eval-test-data/ -Peval-tests&#xA;                        &#xA;               "/>
          </children>
        </children>
        <children xsi:type="mlm:WrappingNode" transient="true">
          <children xsi:type="mlm:Section" level="3">
            <title xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:Anchor" name="opennlp.evaltest.howtochangeit"/>
              <children xsi:type="mlm:RawText" text="How to change evaluation data?"/>
            </title>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:RawText" text="OpenNLP Evaluation Tests use "/>
              <children xsi:type="mlm:Reference" link="https://nightlies.apache.org/">
                <title xsi:type="mlm:RawText" text="nightlies.apache.org"/>
              </children>
              <children xsi:type="mlm:RawText" text=" to share data for testing and releasing candidate build. You can also upload the opennlp-data.zip to "/>
              <children xsi:type="mlm:RawText" text="nightlies.apache.org"/>
              <children xsi:type="mlm:RawText" text=" as below:"/>
            </children>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:CodeListing">
            <content xsi:type="mlm:RawText" text="                                &#xA;curl -u your_asf_username -T ./opennlp-data.zip &quot;https://nightlies.apache.org/opennlp/&quot;&#xA;                                &#xA;                       "/>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:RawText" text="More information about changing the evaluation test data on "/>
              <children xsi:type="mlm:RawText" text="nightlies.apache.org"/>
              <children xsi:type="mlm:RawText" text=" can be found at: "/>
              <children xsi:type="mlm:Reference" link="https://nightlies.apache.org/authoring.html">
                <title xsi:type="mlm:RawText" text="https://nightlies.apache.org/authoring.html"/>
              </children>
            </children>
            <children xsi:type="mlm:LineBreak"/>
          </children>
        </children>
      </children>
    </children>
  </children>
</mlm:WrappingNode>

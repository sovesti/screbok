            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="Sample code to train a model using above tag dictionary"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:RawText" text="                        &#xA;POSModel model = null;&#xA;        "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="try"/>
                </children>
                <children xsi:type="mlm:RawText" text=" {&#xA;                ObjectStream&lt;String> lineStream = "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" PlainTextByLineStream(&#xA;                                "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" MarkableFileInputStreamFactory("/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" File("/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;en-custom-pos.train&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=")), StandardCharsets.UTF_"/>
                <children xsi:type="mlm:RawText" text="8"/>
                <children xsi:type="mlm:RawText" text=");&#xA;&#xA;                ObjectStream&lt;POSSample> sampleStream = "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" WordTagSampleStream(lineStream);&#xA;&#xA;                TrainingParameters params = ModelUtil.createDefaultTrainingParameters();&#xA;                params.put(TrainingParameters.CUTOFF_PARAM, "/>
                <children xsi:type="mlm:RawText" text="0"/>
                <children xsi:type="mlm:RawText" text=");&#xA;&#xA;                POSTaggerFactory factory = "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" POSTaggerFactory();&#xA;                TagDictionary dict = factory.createTagDictionary("/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" File("/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;dictionary.xml&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text="));&#xA;                factory.setTagDictionary(dict);&#xA;&#xA;                model = POSTaggerME.train("/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;eng&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", sampleStream, params, factory);&#xA;&#xA;                OutputStream modelOut = "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" BufferedOutputStream("/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" FileOutputStream("/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;en-custom-pos-maxent.bin&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text="));&#xA;                model.serialize(modelOut);&#xA;&#xA;        } "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="catch"/>
                </children>
                <children xsi:type="mlm:RawText" text=" (IOException e) {&#xA;                e.printStackTrace();&#xA;        }&#xA;                       "/>
              </content>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="The custom model is then used to tag a sequence."/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:RawText" text="                        &#xA;String[] sent = "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:RawText" text="new"/>
                </children>
                <children xsi:type="mlm:RawText" text=" String[]{"/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;Spring&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;is&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;my&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;favourite&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;season&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text=", "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot;.&quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text="};&#xA;String[] tags = tagger.tag(sent);&#xA;Arrays.stream(tags).forEach(k -> System.out.print(k + "/>
                <children xsi:type="mlm:Emphasized" type="BOLD">
                  <parts xsi:type="mlm:Emphasized">
                    <parts xsi:type="mlm:RawText" text="&quot; &quot;"/>
                  </parts>
                </children>
                <children xsi:type="mlm:RawText" text="));&#xA;               "/>
              </content>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:WrappingNode" name="br"/>
                <children xsi:type="mlm:RawText" text=" Input"/>
                <children xsi:type="mlm:WrappingNode" name="br"/>
                <children xsi:type="mlm:RawText" text=" &#xa0;&#xa0;&#xa0;&#xa0;Sentence: Spring&#xa0;is&#xa0;my&#xa0;favourite&#xa0;season."/>
                <children xsi:type="mlm:WrappingNode" name="br"/>
                <children xsi:type="mlm:WrappingNode" name="br"/>
                <children xsi:type="mlm:RawText" text=" Output"/>
                <children xsi:type="mlm:WrappingNode" name="br"/>
                <children xsi:type="mlm:RawText" text=" &#xa0;&#xa0;&#xa0;&#xa0;POS&#xa0;Tags&#xa0;using&#xa0;the&#xa0;custom&#xa0;model&#xa0;(en-custom-pos-maxent.bin):&#xa0;PROPN&#xa0;OTHER&#xa0;PRON&#xa0;ADJ&#xa0;NOUN&#xa0;PUNCT"/>
                <children xsi:type="mlm:WrappingNode" name="br"/>
                <children xsi:type="mlm:WrappingNode" name="br"/>
                <children xsi:type="mlm:RawText" text=" Output&#xa0;with&#xa0;the&#xa0;default&#xa0;model"/>
                <children xsi:type="mlm:WrappingNode" name="br"/>
                <children xsi:type="mlm:RawText" text=" &#xa0;&#xa0;&#xa0;&#xa0;POS&#xa0;Tags&#xa0;using&#xa0;the&#xa0;default&#xa0;model&#xa0;(opennlp-en-ud-ewt-pos-1.3-2.5.4.bin): NOUN&#xa0;AUX&#xa0;PRON&#xa0;ADJ&#xa0;NOUN&#xa0;PUNCT"/>
                <children xsi:type="mlm:WrappingNode" name="br"/>
              </children>
              <children xsi:type="mlm:LineBreak"/>
            </children>
          </children>
        </children>
        <children xsi:type="mlm:WrappingNode" transient="true">
          <children xsi:type="mlm:Section" level="3">
            <title xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:Anchor" name="tools.postagger.eval"/>
              <children xsi:type="mlm:RawText" text="Evaluation"/>
            </title>
          </children>
          <children xsi:type="mlm:LineBreak"/>
          <children xsi:type="mlm:MarkupList">
            <items xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:Reference" link="#tools.postagger.eval.tool" referenced="//@children.0/@children.1/@children.9/@children.4/@children.4/@children.0/@title/@children.0">
                <title xsi:type="mlm:RawText" text="Evaluation Tool"/>
              </children>
              <children xsi:type="mlm:WrappingNode" transient="true"/>
            </items>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="The built-in evaluation can measure the accuracy of the pos tagger. The accuracy can be measured on a test data set or via cross validation."/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:Section" level="4">
              <title xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:Anchor" name="tools.postagger.eval.tool"/>
                <children xsi:type="mlm:RawText" text="Evaluation Tool"/>
              </title>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="There is a command line tool to evaluate a given model on a test data set. The following command shows how the tool can be run:"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:RawText" text="                                &#xA;$ opennlp POSTaggerEvaluator -model pt.postagger.bin -data pt.postagger.test -encoding utf-8&#xA;                        "/>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="This will display the resulting accuracy score, e.g.:"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:RawText" text="                                &#xA;Loading model ... done&#xA;Evaluating ... done&#xA;&#xA;Accuracy: 0.9659110277825124&#xA;                        "/>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="There is a command line tool for cross-validation of the test data set. The following command shows how the tool can be run:"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:RawText" text="                    &#xA;$ opennlp POSTaggerCrossValidator -lang pt -data pt.postagger.test -encoding utf-8&#xA;                "/>
            </children>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:LineBreak"/>
              <children xsi:type="mlm:RawText" text="This will display the resulting accuracy score, e.g.:"/>
              <children xsi:type="mlm:LineBreak"/>
            </children>
            <children xsi:type="mlm:CodeListing">
              <content xsi:type="mlm:RawText" text="                    &#xA;Accuracy: 0.9659110277825124&#xA;                "/>
            </children>
          </children>
        </children>
      </children>
      <children xsi:type="mlm:WrappingNode" transient="true">
        <children xsi:type="mlm:Section" level="2">
          <title xsi:type="mlm:WrappingNode" transient="true">
            <children xsi:type="mlm:Anchor" name="tools.lemmatizer"/>
            <children xsi:type="mlm:RawText" text="Chapter&#xa0;8.&#xa0;Lemmatizer"/>
          </title>
        </children>
        <children xsi:type="mlm:Section" level="5">

              <children xsi:type="mlm:Reference" link="#tools.lemmatizer.training" referenced="//@children.0/@children.1/@children.10/@children.5/@children.0/@title/@children.0">
                <title xsi:type="mlm:RawText" text="Lemmatizer Training"/>
              </children>
              <children xsi:type="mlm:WrappingNode" transient="true"/>
            </children>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:MarkupList">
              <items xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:WrappingNode">
                  <children xsi:type="mlm:Reference" link="#tools.lemmatizer.training.tool" referenced="//@children.0/@children.1/@children.10/@children.5/@children.7/@children.0/@title/@children.0">
                    <title xsi:type="mlm:RawText" text="Training Tool"/>
                  </children>
                  <children xsi:type="mlm:WrappingNode" transient="true"/>
                </children>
                <children xsi:type="mlm:WrappingNode">
                  <children xsi:type="mlm:Reference" link="#tools.lemmatizer.training.api" referenced="//@children.0/@children.1/@children.10/@children.5/@children.8/@children.0/@title/@children.0">
                    <title xsi:type="mlm:RawText" text="Training API"/>
                  </children>
                  <children xsi:type="mlm:WrappingNode" transient="true"/>
                </children>
              </items>
            </children>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:Reference" link="#tools.lemmatizer.evaluation" referenced="//@children.0/@children.1/@children.10/@children.6/@children.0/@title/@children.0">
                <title xsi:type="mlm:RawText" text="Lemmatizer Evaluation"/>
              </children>
              <children xsi:type="mlm:WrappingNode" transient="true"/>
            </children>
            <children xsi:type="mlm:LineBreak"/>
          </children>
        </children>
        <children xsi:type="mlm:WrappingNode">
          <children xsi:type="mlm:LineBreak"/>
          <children xsi:type="mlm:RawText" text="The lemmatizer returns, for a given word form (token) and Part of Speech tag, the dictionary form of a word, which is usually referred to as its lemma. A token could ambiguously be derived from several basic forms or dictionary words which is why the postag of the word is required to find the lemma. For example, the form `show' may refer to either the verb &quot;to show&quot; or to the noun &quot;show&quot;. Currently, OpenNLP implement statistical and dictionary-based lemmatizers."/>
          <children xsi:type="mlm:LineBreak"/>
        </children>
        <children xsi:type="mlm:WrappingNode" transient="true">
          <children xsi:type="mlm:Section" level="3">
            <title xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:Anchor" name="tools.lemmatizer.tagging.cmdline"/>
              <children xsi:type="mlm:RawText" text="Lemmatizer Tool"/>
            </title>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="The easiest way to try out the Lemmatizer is the command line tool, which provides access to the statistical lemmatizer. Note that the tool is only intended for demonstration and testing."/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="Once you have trained a lemmatizer model (see below for instructions), you can start the Lemmatizer Tool with this command:"/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:CodeListing">
            <content xsi:type="mlm:RawText" text="                   &#xA;$ opennlp LemmatizerME opennlp-en-ud-ewt-lemmas-1.3-2.5.4.bin &lt; sentences&#xA;                 "/>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="The Lemmatizer now reads a pos tagged sentence(s) per line from standard input. For example, you can copy this sentence to the console:"/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:CodeListing">
            <content xsi:type="mlm:RawText" text="                    &#xA;Rockwell_PROPN International_ADJ Corp_NOUN 's_PUNCT Tulsa_PROPN unit_NOUN said_VERB it_PRON&#xA;signed_VERB a_DET tentative_NOUN agreement_NOUN extending_VERB its_PRON contract_NOUN&#xA;with_ADP Boeing_PROPN Co._NOUN to_PART provide_VERB structural_ADJ parts_NOUN for_ADP&#xA;Boeing_PROPN 's_PUNCT 747_NUM jetliners_NOUN ._PUNCT&#xA;                 "/>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="The Lemmatizer will now echo the lemmas for each word postag pair to the console:"/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:CodeListing">
            <content xsi:type="mlm:RawText" text="                    &#xA;Rockwell        PROPN   rockwell&#xA;International   ADJ     international&#xA;Corp    NOUN    corp&#xA;'s      PUNCT   's&#xA;Tulsa   PROPN   tulsa&#xA;unit    NOUN    unit&#xA;said    VERB    say&#xA;it      PRON    it&#xA;signed  VERB    sign&#xA;...&#xA;&#xA;                 "/>
          </children>
        </children>
        <children xsi:type="mlm:WrappingNode" transient="true">
          <children xsi:type="mlm:Section" level="3">
            <title xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:Anchor" name="tools.lemmatizer.tagging.api"/>
              <children xsi:type="mlm:RawText" text="Lemmatizer API"/>
            </title>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="The Lemmatizer can be embedded into an application via its API. Currently, a statistical and DictionaryLemmatizer are available. Note that these two methods are complementary and the DictionaryLemmatizer can also be used as a way of post-processing the output of the statistical lemmatizer."/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="The statistical lemmatizer requires that a trained model is loaded into memory from disk or from another source. In the example below it is loaded from disk:"/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:CodeListing">
            <content xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:RawText" text="                &#xA;LemmatizerModel model = null;&#xA;"/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="try"/>
              </children>
              <children xsi:type="mlm:RawText" text=" (InputStream modelIn = "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="new"/>
              </children>
              <children xsi:type="mlm:RawText" text=" FileInputStream("/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:Emphasized">
                  <parts xsi:type="mlm:RawText" text="&quot;opennlp-en-ud-ewt-lemmas-1.3-2.5.4.bin&quot;"/>
                </parts>
              </children>
              <children xsi:type="mlm:RawText" text="))) {&#xA;  model = "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="new"/>
              </children>
              <children xsi:type="mlm:RawText" text=" LemmatizerModel(modelIn);&#xA;}&#xA;&#xA;                       "/>
            </content>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="After the model is loaded a LemmatizerME can be instantiated."/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:CodeListing">
            <content xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:RawText" text="                                &#xA;LemmatizerME lemmatizer = "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="new"/>
              </children>
              <children xsi:type="mlm:RawText" text=" LemmatizerME(model);&#xA;                       "/>
            </content>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="The Lemmatizer instance is now ready to lemmatize data. It expects a tokenized sentence as input, which is represented as a String array, each String object in the array is one token, and the POS tags associated with each token."/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:WrappingNode">
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:RawText" text="The following code shows how to determine the most likely lemma for a sentence."/>
            <children xsi:type="mlm:LineBreak"/>
          </children>
          <children xsi:type="mlm:CodeListing">
            <content xsi:type="mlm:WrappingNode" transient="true">
              <children xsi:type="mlm:RawText" text="                  &#xA;String[] tokens = "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:RawText" text="new"/>
              </children>
              <children xsi:type="mlm:RawText" text=" String[] { "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:Emphasized">
                  <parts xsi:type="mlm:RawText" text="&quot;Rockwell&quot;"/>
                </parts>
              </children>
              <children xsi:type="mlm:RawText" text=", "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:Emphasized">
                  <parts xsi:type="mlm:RawText" text="&quot;International&quot;"/>
                </parts>
              </children>
              <children xsi:type="mlm:RawText" text=", "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:Emphasized">
                  <parts xsi:type="mlm:RawText" text="&quot;Corp.&quot;"/>
                </parts>
              </children>
              <children xsi:type="mlm:RawText" text=", "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:Emphasized">
                  <parts xsi:type="mlm:RawText" text="&quot;'s&quot;"/>
                </parts>
              </children>
              <children xsi:type="mlm:RawText" text=",&#xA;    "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:Emphasized">
                  <parts xsi:type="mlm:RawText" text="&quot;Tulsa&quot;"/>
                </parts>
              </children>
              <children xsi:type="mlm:RawText" text=", "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:Emphasized">
                  <parts xsi:type="mlm:RawText" text="&quot;unit&quot;"/>
                </parts>
              </children>
              <children xsi:type="mlm:RawText" text=", "/>
              <children xsi:type="mlm:Emphasized" type="BOLD">
                <parts xsi:type="mlm:Emphasized">

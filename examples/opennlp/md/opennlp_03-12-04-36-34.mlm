                  <children xsi:type="mlm:Reference" link="#tools.namefind.training.tool" referenced="//@children.0/@children.1/@children.7/@children.3/@children.4/@children.0/@title/@children.0">
                    <title xsi:type="mlm:RawText" text="Training Tool"/>
                  </children>
                  <children xsi:type="mlm:WrappingNode" transient="true"/>
                </children>
                <children xsi:type="mlm:WrappingNode">
                  <children xsi:type="mlm:Reference" link="#tools.namefind.training.api" referenced="//@children.0/@children.1/@children.7/@children.3/@children.5/@children.0/@title/@children.0">
                    <title xsi:type="mlm:RawText" text="Training API"/>
                  </children>
                  <children xsi:type="mlm:WrappingNode" transient="true"/>
                </children>
                <children xsi:type="mlm:WrappingNode">
                  <children xsi:type="mlm:Reference" link="#tools.namefind.training.featuregen" referenced="//@children.0/@children.1/@children.7/@children.3/@children.6/@children.0/@title/@children.0">
                    <title xsi:type="mlm:RawText" text="Custom Feature Generation"/>
                  </children>
                  <children xsi:type="mlm:LineBreak"/>

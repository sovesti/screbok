                  <children xsi:type="mlm:Emphasized" type="BOLD">
                    <parts xsi:type="mlm:RawText" text="&lt;generator"/>
                  </children>
                  <children xsi:type="mlm:RawText" text=" "/>
                  <children xsi:type="mlm:RawText" text="class"/>
                  <children xsi:type="mlm:RawText" text="="/>
                  <children xsi:type="mlm:RawText" text="&quot;opennlp.tools.util.featuregen.WordClusterFeatureGeneratorFactory&quot;"/>
                  <children xsi:type="mlm:Emphasized" type="BOLD">
                    <parts xsi:type="mlm:RawText" text=">"/>

              <children xsi:type="mlm:Reference" link="#tools.namefind.training" referenced="//@children.0/@children.1/@children.7/@children.3/@children.0/@title/@children.0">
                <title xsi:type="mlm:RawText" text="Name Finder Training"/>
              </children>
              <children xsi:type="mlm:WrappingNode" transient="true"/>
            </children>
            <children xsi:type="mlm:LineBreak"/>

                <children xsi:type="mlm:WrappingNode">
                  <children xsi:type="mlm:Reference" link="#tools.namefind.recognition.cmdline" referenced="//@children.0/@children.1/@children.7/@children.2/@children.4/@children.0/@title/@children.0">
                    <title xsi:type="mlm:RawText" text="Name Finder Tool"/>

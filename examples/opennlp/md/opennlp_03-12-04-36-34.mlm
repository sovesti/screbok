              <items xsi:type="mlm:WrappingNode" transient="true">
                <children xsi:type="mlm:WrappingNode">
                  <children xsi:type="mlm:Reference" link="#intro.models.native" referenced="//@children.0/@children.1/@children.3/@children.6/@children.3/@children.0/@title/@children.0">
                    <title xsi:type="mlm:RawText" text="OpenNLP Models"/>
                  </children>
                  <children xsi:type="mlm:WrappingNode" transient="true"/>
                </children>
                <children xsi:type="mlm:WrappingNode">
                  <children xsi:type="mlm:Reference" link="#intro.models.onnx" referenced="//@children.0/@children.1/@children.3/@children.6/@children.4/@children.0/@title/@children.0">
                    <title xsi:type="mlm:RawText" text="ONNX Models"/>
                  </children>
                  <children xsi:type="mlm:WrappingNode" transient="true"/>
                </children>
              </items>
            </children>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:LineBreak"/>
            <children xsi:type="mlm:WrappingNode">
              <children xsi:type="mlm:Reference" link="#intro.sysprops" referenced="//@children.0/@children.1/@children.3/@children.7/@children.0/@title/@children.0">
                <title xsi:type="mlm:RawText" text="System Properties"/>
              </children>
              <children xsi:type="mlm:WrappingNode" transient="true"/>
            </children>
            <children xsi:type="mlm:LineBreak"/>

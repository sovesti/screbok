<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension
         id="app"
         point="org.eclipse.core.runtime.applications">
      <application
            cardinality="singleton-global"
            thread="main"
            visible="true">
         <run
               class="ru.mkn.sovesti.screbok.ui.workbench.ScrebokApplication">
         </run>
      </application>
   </extension>
   <extension
         id="screbok_ui"
         point="org.eclipse.core.runtime.products">
      <product
            application="ru.mkn.sovesti.screbok.ui.workbench.screbok"
            name="Screbok">
      </product>
   </extension>
   <extension
         id="product"
         point="org.eclipse.core.runtime.products">
      <product
            application="ru.mkn.sovesti.screbok.ui.workbench.app"
            name="Screbok">
         <property
               name="appName"
               value="Screbok">
         </property>
      </product>
   </extension>
   <extension point="org.eclipse.ui.perspectives">
      <perspective
          id="ru.mkn.sovesti.screbok.perspective"
          name="Screbok"
          class="ru.mkn.sovesti.screbok.ui.workbench.ScrebokPerspective">
      </perspective>
   </extension>

</plugin>
